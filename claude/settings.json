{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 99999,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(gh pr:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(npx mocha:*)",
      "BashOutput",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "SlashCommand",
      "Task",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": []
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.dotfiles/claude/statusline.py"
  },
  "alwaysThinkingEnabled": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Working"]
  },
  "spinnerTipsEnabled": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "preferredNotifChannel": "ghostty",
  "feedbackSurveyState": {
    "lastShownTime": 1754083542456
  }
}
