#!/usr/bin/env bash

set -euo pipefail

readonly formula="tkersey/tap/ledger"
install_allowed=false
minimum_version="1.6.0"
minimum_minor=6
minimum_patch=0

usage() {
  cat <<'HELP'
ensure-ledger

usage:
  ensure-ledger [--min-version 1.MINOR.PATCH] [--install]

Ensures a ledger command resolves on PATH. With --install, installs the native
Ledger CLI's Homebrew formula when ledger is missing or upgrades it when the
installed CLI does not satisfy readiness. Readiness defaults to Ledger 1.6.0 or
newer within major version 1 and ledger-artifact-abi/v1. Owners can require a
higher minimum with --min-version; it cannot lower the 1.6.0 baseline. The handler
does not proxy native commands.
HELP
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

emit_error() {
  local reason="$1"
  local remediation="$2"
  printf '{"schema":"ledger-bootstrap-error/v1","status":"blocked","reason":"%s","remediation":"%s"}\n' \
    "$(json_escape "$reason")" \
    "$(json_escape "$remediation")" >&2
}

ledger_path=""
ledger_version=""
ledger_abi=""

inspect_availability() {
  ledger_path="$(command -v ledger 2>/dev/null || true)"
  [[ -n "$ledger_path" ]]
}

inspect_readiness() {
  local capabilities line minor patch
  local abi_found=false
  ledger_version="$("$ledger_path" version 2>/dev/null)" || return 1
  [[ "$ledger_version" =~ ^1\.([0-9]+)\.([0-9]+)$ ]] || return 1
  minor="${BASH_REMATCH[1]}"
  patch="${BASH_REMATCH[2]}"
  if ((10#$minor < 10#$minimum_minor ||
       (10#$minor == 10#$minimum_minor && 10#$patch < 10#$minimum_patch))); then
    return 1
  fi
  capabilities="$("$ledger_path" capabilities --format text 2>/dev/null)" || return 1
  while IFS= read -r line; do
    if [[ "$line" == "ABI: ledger-artifact-abi/v1" ]]; then
      abi_found=true
      break
    fi
  done <<<"$capabilities"
  [[ "$abi_found" == true ]] || return 1
  ledger_abi="ledger-artifact-abi/v1"
}

install_cli() {
  local os="${LEDGER_BOOTSTRAP_OS:-$(uname -s)}"
  if [[ "$os" != "Darwin" && "$os" != "Linux" ]]; then
    emit_error "unsupported-platform" "Install $formula manually, then retry."
    return 2
  fi
  if ! command -v brew >/dev/null 2>&1; then
    emit_error "homebrew-unavailable" "Install Homebrew, then rerun: $install_command"
    return 2
  fi

  if brew list --versions "$formula" >/dev/null 2>&1; then
    emit_error "installed-but-unavailable" "Add the Homebrew ledger executable to PATH, then retry."
    return 2
  fi

  local install_status
  if brew install "$formula" >&2; then
    :
  else
    install_status=$?
    emit_error "homebrew-install-failed" "Fix the Homebrew failure, then rerun: $install_command"
    return "$install_status"
  fi
  printf '%s' "installed"
}

upgrade_cli() {
  local os="${LEDGER_BOOTSTRAP_OS:-$(uname -s)}"
  if [[ "$os" != "Darwin" && "$os" != "Linux" ]] ||
    ! command -v brew >/dev/null 2>&1
  then
    emit_error "version-or-abi-mismatch" "Install or upgrade $formula to Ledger $minimum_version or newer within major version 1 with ledger-artifact-abi/v1, then retry."
    return 2
  fi
  if ! brew list --versions "$formula" >/dev/null 2>&1; then
    emit_error "version-or-abi-mismatch-nonformula" "Replace the current ledger with $formula $minimum_version or newer within major version 1, then retry."
    return 2
  fi
  if ! brew upgrade "$formula" >&2; then
    emit_error "homebrew-upgrade-failed" "Fix the Homebrew failure, then rerun: $install_command"
    return 2
  fi
  printf '%s' "upgraded"
}

while (($#)); do
  case "$1" in
    --min-version)
      if (($# < 2)) || [[ ! "$2" =~ ^1\.([0-9]+)\.([0-9]+)$ ]]; then
        emit_error "invalid-minimum-version" "Use --min-version 1.MINOR.PATCH at least 1.6.0."
        exit 2
      fi
      minimum_version="$2"
      minimum_minor="${BASH_REMATCH[1]}"
      minimum_patch="${BASH_REMATCH[2]}"
      if ((10#$minimum_minor < 6)); then
        emit_error "invalid-minimum-version" "The minimum cannot lower the Ledger 1.6.0 baseline."
        exit 2
      fi
      shift 2
      ;;
    --install)
      install_allowed=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      emit_error "unknown-option" "Use ensure-ledger --help."
      exit 2
      ;;
  esac
done

install_command="ensure-ledger --min-version $minimum_version --install"
action="none"
if ! inspect_availability; then
  if [[ "$install_allowed" != true ]]; then
    emit_error "missing" "Authorize installation, then rerun: $install_command"
    exit 3
  fi

  action="$(install_cli)" || exit $?
  hash -r
  if ! inspect_availability; then
    emit_error "post-install-unavailable" "Verify PATH and the installed $formula formula."
    exit 2
  fi
fi

if ! inspect_readiness; then
  if [[ "$install_allowed" != true ]]; then
    emit_error "version-or-abi-mismatch" "Authorize the canonical upgrade, then rerun: $install_command"
    exit 3
  fi
  action="$(upgrade_cli)" || exit $?
  hash -r
  inspect_availability || {
    emit_error "post-upgrade-unavailable" "Verify PATH and the upgraded $formula formula."
    exit 2
  }
  if ! inspect_readiness; then
    emit_error "post-upgrade-version-or-abi-mismatch" "Verify $formula provides Ledger $minimum_version or newer within major version 1 and ledger-artifact-abi/v1."
    exit 2
  fi
fi

printf '{"schema":"ledger-bootstrap-ready/v1","status":"ready","path":"%s","version":"%s","abi":"%s","action":"%s"}\n' \
  "$(json_escape "$ledger_path")" \
  "$(json_escape "$ledger_version")" \
  "$(json_escape "$ledger_abi")" \
  "$(json_escape "$action")"
