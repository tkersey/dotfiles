        "op": "canonical-json",
        "input": "gate"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "gate",
        "path": "",
        "keys": [
          "source_governance_gate"
        ]
      },
      {
        "op": "exact-object",
        "input": "gate",
        "path": "/source_governance_gate",
        "keys": [
          "classification",
          "evidence",
          "gate_id",
          "gate_version",
          "limitations",
          "source",
          "verdict"
        ]
      },
      {
        "op": "enum",
        "input": "gate",
        "path": "/source_governance_gate/gate_version",
        "values": [
          "SGG-v1"
        ]
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/gate_id",
        "trimmed_min": 1,
        "max": 256
      },
      {
        "op": "exact-object",
        "input": "gate",
        "path": "/source_governance_gate/source",
        "required_keys": [
          "classifier_command",
          "classifier_version",
          "included_row_ref",
          "protocol",
          "rollout_path",
          "session_id",
          "workflow"
        ],
        "allow_additional": false
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/source/session_id",
        "trimmed_min": 1,
        "max": 512
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/source/rollout_path",
        "trimmed_min": 1,
        "max": 4096
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/source/workflow",
        "trimmed_min": 1,
        "max": 256
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/source/protocol",
        "trimmed_min": 1,
        "max": 256
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/source/classifier_command",
        "trimmed_min": 1,
        "max": 4096
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/source/classifier_version",
        "trimmed_min": 1,
        "max": 256
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/source/included_row_ref",
        "trimmed_min": 1,
        "max": 4096
      },
      {
        "op": "exact-object",
        "input": "gate",
        "path": "/source_governance_gate/evidence",
        "keys": [
          "closure",
          "entry",
          "governance",
          "incidental"
        ]
      },
      {
        "op": "object-values",
        "input": "gate",
        "path": "/source_governance_gate/evidence",
        "rules": [
          {
            "op": "bounded-array",
            "path": "",
            "max": 1024
          },
          {
            "op": "all",
            "path": "",
            "rules": [
              {
                "op": "exact-object",
                "required_keys": [
                  "evidence_id",
                  "present",
                  "provenance_role",
                  "source"
                ],
                "optional_keys": [
                  "command",
                  "excerpt",
                  "executable",
                  "matched_cue",
                  "matched_field",
                  "timestamp",
                  "tool_name"
                ],
                "allow_additional": false
              },
              {
                "op": "bounded-string",
                "path": "/evidence_id",
                "trimmed_min": 1,
                "max": 256
              },
              {
                "op": "scalar-type",
                "path": "/present",
                "type": "boolean"
              },
              {
                "op": "bounded-string",
                "path": "/source",
                "trimmed_min": 1,
                "max": 4096
              },
              {
                "op": "enum",
                "path": "/provenance_role",
                "values": [
                  "artifact_under_repair",
                  "controller_event",
                  "controller_invocation",
                  "controller_receipt",
                  "controller_state",
                  "explicit_workflow_declaration",
                  "filename_or_path_mention",
                  "generic_prose",
                  "historical_reference"
                ]
              }
            ]
          }
        ]
      },
      {
        "op": "exact-object",
        "input": "gate",
        "path": "/source_governance_gate/classification",
        "keys": [
          "absent_evidence_reasons",
          "closure_provenance",
          "governance_provenance",
          "governing_evidence_refs",
          "incidental_evidence_refs"
        ]
      },
      {
        "op": "enum",
        "input": "gate",
        "path": "/source_governance_gate/classification/governance_provenance",
        "values": [
          "absent",
          "ambiguous",
          "artifact_under_repair",
          "controller_event",
          "controller_invocation",
          "controller_receipt",
          "controller_state",
          "explicit_workflow_declaration",
          "filename_or_path_mention",
          "generic_prose",
          "historical_reference"
        ]
      },
      {
        "op": "enum",
        "input": "gate",
        "path": "/source_governance_gate/classification/closure_provenance",
        "values": [
          "absent",
          "ambiguous",
          "campaign_bound_terminal",
          "controller_close",
          "controller_receipt",
          "generic_delivery_closure",
          "generic_prose",
          "tool_success_only"
        ]
      },
      {
        "op": "bounded-array",
        "input": "gate",
        "path": "/source_governance_gate/classification/governing_evidence_refs",
        "max": 1024
      },
      {
        "op": "bounded-array",
        "input": "gate",
        "path": "/source_governance_gate/classification/incidental_evidence_refs",
        "max": 1024
      },
      {
        "op": "bounded-array",
        "input": "gate",
        "path": "/source_governance_gate/classification/absent_evidence_reasons",
        "max": 1024
      },
      {
        "op": "exact-object",
        "input": "gate",
        "path": "/source_governance_gate/verdict",
        "keys": [
          "allowed_modes",
          "reason",
          "replay_allowed",
          "state"
        ]
      },
      {
        "op": "enum",
        "input": "gate",
        "path": "/source_governance_gate/verdict/state",
        "values": [
          "absent",
          "ambiguous",
          "authoritative",
          "declared_uncontrolled",
          "incidental"
        ]
      },
      {
        "op": "scalar-type",
        "input": "gate",
        "path": "/source_governance_gate/verdict/replay_allowed",
        "type": "boolean"
      },
      {
        "op": "bounded-array",
        "input": "gate",
        "path": "/source_governance_gate/verdict/allowed_modes",
        "max": 8
      },
      {
        "op": "all",
        "input": "gate",
        "path": "/source_governance_gate/verdict/allowed_modes",
        "rules": [
          {
            "op": "enum",
            "values": [
              "audit",
              "challenge",
              "compare",
              "explain",
              "replay",
              "retrospective"
            ]
          }
        ]
      },
      {
        "op": "bounded-string",
        "input": "gate",
        "path": "/source_governance_gate/verdict/reason",
        "trimmed_min": 1,
        "max": 8192
      },
      {
        "op": "bounded-array",
        "input": "gate",
        "path": "/source_governance_gate/limitations",
        "max": 1024
      },
      {
        "op": "all",
        "input": "gate",
        "path": "/source_governance_gate/limitations",
        "rules": [
          {
            "op": "bounded-string",
            "trimmed_min": 1,
            "max": 8192
          }
        ]
      }
    ]
  },
  "constraints": [
    {
      "op": "implies",
      "input": "gate",
      "if": "/source_governance_gate/verdict/state",
      "equals": "incidental",
      "rules": [
        {
          "op": "enum",
          "path": "/source_governance_gate/verdict/replay_allowed",
          "values": [
            false
          ]
        }
      ]
    },
    {
      "op": "implies",
      "input": "gate",
      "if": "/source_governance_gate/verdict/state",
      "equals": "absent",
      "rules": [
        {
          "op": "enum",
          "path": "/source_governance_gate/verdict/replay_allowed",
          "values": [
            false
          ]
        }
      ]
    }
  ],
  "identity": {
    "op": "content-address",
    "input": "gate"
  },
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 4096,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
