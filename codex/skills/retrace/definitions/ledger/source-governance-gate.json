{
  "schema": "ledger-artifact-definition/v1",
  "id": "retrace/source-governance-gate",
  "owner": "retrace",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "bounded-array",
      "bounded-string",
      "canonical-json",
      "content-address",
      "enum",
      "exact-object",
      "implies",
      "object-values",
      "scalar-type"
    ]
  },
  "parameters": {},
  "inputs": {
    "gate": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
