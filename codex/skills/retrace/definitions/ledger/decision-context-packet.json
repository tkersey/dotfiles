{
  "schema": "ledger-artifact-definition/v1",
  "id": "retrace/decision-context-packet",
  "owner": "retrace",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "bounded-array",
      "bounded-number",
      "bounded-object",
      "bounded-string",
      "canonical-json",
      "content-address",
      "digest",
      "enum",
      "exact-object",
      "optional-field",
      "object-values",
      "one-of",
      "regex",
      "scalar-type"
    ]
  },
  "parameters": {},
  "inputs": {
    "packet": {
      "codec": "json",
      "required": true,
      "max_bytes": 4194304
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "packet"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "packet",
        "path": "",
        "keys": [
          "decision_context_packet"
        ]
      },
      {
        "op": "exact-object",
        "input": "packet",
        "path": "/decision_context_packet",
        "keys": [
          "anchors",
          "artifact_state",
          "contamination",
          "episode",
          "limitations",
          "packet_id",
          "packet_version",
          "source",
          "turns"
        ]
      },
      {
        "op": "enum",
        "input": "packet",
        "path": "/decision_context_packet/packet_version",
        "values": [
          "DCP-v2"
        ]
      },
      {
        "op": "one-of",
        "input": "packet",
        "path": "/decision_context_packet/packet_id",
        "rules": [
          {
            "op": "enum",
            "values": [
              null
            ]
          },
          {
            "op": "regex",
            "path": "",
            "patterns": [
              "^DCP-[a-f0-9]{64}$"
            ],
            "max": 68
          }
        ]
      },
      {
        "op": "exact-object",
        "input": "packet",
        "path": "/decision_context_packet/source",
        "required_keys": [
          "decision_id"
        ],
        "optional_keys": [
          "root_session_id",
          "rollout_path",
          "session_id",
          "source_episode_id",
          "source_codex_version",
          "source_model",
          "source_model_provider",
          "thread_id",
          "worker_session_id"
        ],
        "allow_additional": false
      },
      {
        "op": "optional-field",
        "input": "packet",
        "path": "/decision_context_packet/source/session_id",
        "allow_null": true,
        "rules": [
          {
            "op": "bounded-string",
            "path": "",
            "trimmed_min": 1,
            "max": 512
          }
        ]
      },
      {
        "op": "optional-field",
        "input": "packet",
        "path": "/decision_context_packet/source/rollout_path",
        "allow_null": true,
        "rules": [
          {
            "op": "bounded-string",
            "path": "",
            "trimmed_min": 1,
            "max": 4096
          }
        ]
      },
      {
        "op": "bounded-string",
        "input": "packet",
        "path": "/decision_context_packet/source/decision_id",
        "trimmed_min": 1,
        "max": 512
      },
      {
        "op": "exact-object",
        "input": "packet",
        "path": "/decision_context_packet/artifact_state",
        "keys": [
          "branch",
          "cwd",
          "dependency_refs",
          "dirty_fingerprint",
          "dirty_patch_ref",
          "generated_artifact_refs",
          "head",
          "reconstructability",
          "repository_root"
        ]
      },
      {
        "op": "enum",
        "input": "packet",
        "path": "/decision_context_packet/artifact_state/reconstructability",
        "values": [
          "exact",
          "head_only",
          "transcript_only",
          "unavailable"
        ]
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/artifact_state/generated_artifact_refs",
        "max": 4096
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/artifact_state/dependency_refs",
        "max": 4096
      },
      {
        "op": "exact-object",
        "input": "packet",
        "path": "/decision_context_packet/episode",
        "keys": [
          "evidence_refs",
          "explicit_assumptions",
          "explicit_rationale",
          "outcome_refs",
          "question",
          "rejected_routes",
          "selected_route",
          "skills_and_instructions",
          "tools_and_artifacts"
        ]
      },
      {
        "op": "bounded-string",
        "input": "packet",
        "path": "/decision_context_packet/episode/question",
        "trimmed_min": 1,
        "max": 65536
      },
      {
        "op": "bounded-string",
        "input": "packet",
        "path": "/decision_context_packet/episode/selected_route",
        "trimmed_min": 1,
        "max": 65536
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/episode/rejected_routes",
        "max": 1024
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/episode/explicit_rationale",
        "max": 4096
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/episode/explicit_assumptions",
        "max": 4096
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/episode/evidence_refs",
        "max": 4096
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/episode/tools_and_artifacts",
        "max": 4096
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/episode/skills_and_instructions",
        "max": 4096
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/episode/outcome_refs",
        "max": 4096
      },
      {
        "op": "exact-object",
        "input": "packet",
        "path": "/decision_context_packet/turns",
        "keys": [
          "decision_turn_id",
          "decision_turn_index",
          "first_outcome_turn_index",
          "following_turn_id",
          "preceding_turn_id",
          "source_turn_digest",
          "total_turns"
        ]
      },
      {
        "op": "scalar-type",
        "input": "packet",
        "path": "/decision_context_packet/turns/total_turns",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "input": "packet",
        "path": "/decision_context_packet/turns/total_turns",
        "min": 1
      },
      {
        "op": "scalar-type",
        "input": "packet",
        "path": "/decision_context_packet/turns/decision_turn_index",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "input": "packet",
        "path": "/decision_context_packet/turns/decision_turn_index",
        "min": 1
      },
      {
        "op": "digest",
        "input": "packet",
        "path": "/decision_context_packet/turns/source_turn_digest"
      },
      {
        "op": "exact-object",
        "input": "packet",
        "path": "/decision_context_packet/anchors",
        "keys": [
          "outcome_aware",
          "post_decision_pre_outcome",
          "pre_decision"
        ]
      },
      {
        "op": "object-values",
        "input": "packet",
        "path": "/decision_context_packet/anchors",
        "rules": [
          {
            "op": "exact-object",
            "path": "",
            "keys": [
              "anchor_digest",
              "available",
              "drop_last_n_turns",
              "keep_through_turn_index"
            ]
          },
          {
            "op": "scalar-type",
            "path": "/available",
            "type": "boolean"
          },
          {
            "op": "one-of",
            "path": "/keep_through_turn_index",
            "rules": [
              {
                "op": "enum",
                "values": [
                  null
                ]
              },
              {
                "op": "scalar-type",
                "type": "integer"
              }
            ]
          },
          {
            "op": "one-of",
            "path": "/drop_last_n_turns",
            "rules": [
              {
                "op": "enum",
                "values": [
                  null
                ]
              },
              {
                "op": "scalar-type",
                "type": "integer"
              }
            ]
          },
          {
            "op": "one-of",
            "path": "/anchor_digest",
            "rules": [
              {
                "op": "enum",
                "values": [
                  null
                ]
              },
              {
                "op": "digest"
              }
            ]
          }
        ]
      },
      {
        "op": "exact-object",
        "input": "packet",
        "path": "/decision_context_packet/contamination",
        "keys": [
          "current_audit_prompt",
          "generated_reports",
          "injected_skill_blocks",
          "quoted_material"
        ]
      },
      {
        "op": "object-values",
        "input": "packet",
        "path": "/decision_context_packet/contamination",
        "rules": [
          {
            "op": "scalar-type",
            "path": "",
            "type": "boolean"
          }
        ]
      },
      {
        "op": "bounded-array",
        "input": "packet",
        "path": "/decision_context_packet/limitations",
        "max": 4096
      },
      {
        "op": "all",
        "input": "packet",
        "path": "/decision_context_packet/limitations",
        "rules": [
          {
            "op": "bounded-string",
            "trimmed_min": 1,
            "max": 65536
          }
        ]
      }
    ]
  },
  "constraints": [],
  "identity": {
    "op": "content-address",
    "input": "packet",
    "exclude": "/packet_id",
    "exclude_recursive": true,
    "prefix": "DCP-",
    "field": "/decision_context_packet/packet_id"
  },
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 4194304,
    "max_store_bytes": 4194304,
    "max_records": 16384,
    "max_output_bytes": 4194304,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
