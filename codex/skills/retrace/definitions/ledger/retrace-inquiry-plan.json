{
  "schema": "ledger-artifact-definition/v1",
  "id": "retrace/retrace-inquiry-plan",
  "owner": "retrace",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "bounded-array",
      "bounded-number",
      "bounded-string",
      "canonical-json",
      "content-address",
      "enum",
      "exact-object",
      "implies",
      "safe-identifier",
      "scalar-type"
    ]
  },
  "parameters": {},
  "inputs": {
    "plan": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "plan"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "plan",
        "path": "",
        "keys": [
          "retrace_inquiry_plan"
        ]
      },
      {
        "op": "exact-object",
        "input": "plan",
        "path": "/retrace_inquiry_plan",
        "keys": [
          "budgets",
          "cleanup",
          "inquiry_id",
          "lanes",
          "model_policy",
          "objective",
          "permission_policy",
          "plan_version",
          "source_capsule",
          "workspace_policy"
        ]
      },
      {
        "op": "enum",
        "input": "plan",
        "path": "/retrace_inquiry_plan/plan_version",
        "values": [
          "RIP-v1"
        ]
      },
      {
        "op": "safe-identifier",
        "input": "plan",
        "path": "/retrace_inquiry_plan/inquiry_id",
        "max": 256,
        "style": "portable"
      },
      {
        "op": "bounded-string",
        "input": "plan",
        "path": "/retrace_inquiry_plan/source_capsule",
        "trimmed_min": 1,
        "max": 256
      },
      {
        "op": "bounded-string",
        "input": "plan",
        "path": "/retrace_inquiry_plan/objective",
        "trimmed_min": 1,
        "max": 65536
      },
      {
        "op": "bounded-string",
        "input": "plan",
        "path": "/retrace_inquiry_plan/model_policy",
        "trimmed_min": 1,
        "max": 1024
      },
      {
        "op": "enum",
        "input": "plan",
        "path": "/retrace_inquiry_plan/workspace_policy",
        "values": [
          "exact",
          "head_only",
          "transcript_only"
        ]
      },
      {
        "op": "exact-object",
        "input": "plan",
        "path": "/retrace_inquiry_plan/permission_policy",
        "keys": [
          "network",
          "read_only"
        ]
      },
      {
        "op": "enum",
        "input": "plan",
        "path": "/retrace_inquiry_plan/permission_policy/read_only",
        "values": [
          true
        ]
      },
      {
        "op": "enum",
        "input": "plan",
        "path": "/retrace_inquiry_plan/permission_policy/network",
        "values": [
          false
        ]
      },
      {
        "op": "bounded-array",
        "input": "plan",
        "path": "/retrace_inquiry_plan/lanes",
        "min": 1,
        "max": 16
      },
      {
        "op": "all",
        "input": "plan",
        "path": "/retrace_inquiry_plan/lanes",
        "rules": [
          {
            "op": "exact-object",
            "keys": [
              "evidence_allowed",
              "evidence_withheld",
              "fork_count",
              "inquiry_mode",
              "lane_id",
              "prompt_template",
              "temporal_horizon"
            ]
          },
          {
            "op": "safe-identifier",
            "path": "/lane_id",
            "max": 128,
            "style": "portable"
          },
          {
            "op": "enum",
            "path": "/temporal_horizon",
            "values": [
              "outcome_aware",
              "post_decision_pre_outcome",
              "pre_decision"
            ]
          },
          {
            "op": "enum",
            "path": "/inquiry_mode",
            "values": [
              "alternative_challenge",
              "assumption_probe",
              "counterfactual",
              "evidence_ablation",
              "rationale",
              "replay",
              "retrospective"
            ]
          },
          {
            "op": "scalar-type",
            "path": "/fork_count",
            "type": "integer"
          },
          {
            "op": "bounded-number",
            "path": "/fork_count",
            "min": 1,
            "max": 4
          },
          {
            "op": "bounded-string",
            "path": "/prompt_template",
            "trimmed_min": 1,
            "max": 65536
          },
          {
            "op": "bounded-array",
            "path": "/evidence_allowed",
            "max": 4096
          },
          {
            "op": "bounded-array",
            "path": "/evidence_withheld",
            "max": 4096
          },
          {
            "op": "implies",
            "if": "/inquiry_mode",
            "equals": "counterfactual",
            "rules": [
              {
                "op": "enum",
                "path": "/temporal_horizon",
                "values": [
                  "pre_decision"
                ]
              }
            ]
          },
          {
            "op": "implies",
            "if": "/inquiry_mode",
            "equals": "alternative_challenge",
            "rules": [
              {
                "op": "enum",
                "path": "/temporal_horizon",
                "values": [
                  "pre_decision"
                ]
              }
            ]
          },
          {
            "op": "implies",
            "if": "/inquiry_mode",
            "equals": "replay",
            "rules": [
              {
                "op": "enum",
                "path": "/temporal_horizon",
                "values": [
                  "pre_decision"
                ]
              },
              {
                "op": "enum",
                "path": "/fork_count",
                "values": [
                  1
                ]
              }
            ]
          },
          {
            "op": "implies",
            "if": "/inquiry_mode",
            "equals": "retrospective",
            "rules": [
              {
                "op": "enum",
                "path": "/temporal_horizon",
                "values": [
                  "outcome_aware"
                ]
              }
            ]
          }
        ]
      },
      {
        "op": "exact-object",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets",
        "keys": [
          "max_forks",
          "max_total_tokens",
          "max_turns_per_fork",
          "timeout_ms"
        ]
      },
      {
        "op": "scalar-type",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets/max_forks",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets/max_forks",
        "min": 1,
        "max": 4
      },
      {
        "op": "scalar-type",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets/max_turns_per_fork",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets/max_turns_per_fork",
        "min": 1,
        "max": 1
      },
      {
        "op": "scalar-type",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets/max_total_tokens",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets/max_total_tokens",
        "min": 1
      },
      {
        "op": "scalar-type",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets/timeout_ms",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "input": "plan",
        "path": "/retrace_inquiry_plan/budgets/timeout_ms",
        "min": 1
      },
      {
        "op": "bounded-string",
        "input": "plan",
        "path": "/retrace_inquiry_plan/cleanup",
        "trimmed_min": 1,
        "max": 1024
      }
    ]
  },
  "constraints": [],
  "identity": {
    "op": "content-address",
    "input": "plan"
  },
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 4096,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
