{
  "schema": "ledger-artifact-definition/v1",
  "id": "actuating/review-contract",
  "owner": "actuating",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "bounded-array",
      "bounded-number",
      "bounded-string",
      "digest",
      "enum",
      "exact-object",
      "keyed-unique",
      "reference-exists",
      "safe-identifier",
      "safe-relative-path",
      "scalar-type",
      "sha256",
      "sorted",
      "unique"
    ]
  },
  "inputs": {
    "contract": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {},
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "path": "",
        "keys": [
          "lens_contract_manifests",
          "review_contract"
        ]
      },
      {
        "op": "bounded-array",
        "path": "/lens_contract_manifests",
        "min": 1,
        "max": 64
      },
      {
        "op": "all",
        "path": "/lens_contract_manifests",
        "rules": [
          {
            "op": "exact-object",
            "keys": [
              "contract_digest",
              "contract_ref",
              "name",
              "resources"
            ]
          },
          {
            "op": "safe-identifier",
            "path": "/name",
            "min": 1,
            "max": 128,
            "style": "portable"
          },
          {
            "op": "safe-relative-path",
            "path": "/contract_ref",
            "allow_root": true,
            "reserved_roots": [
              ".git",
              ".ledger"
            ],
            "case_insensitive_reserved": false
          },
          {
            "op": "digest",
            "path": "/contract_digest"
          },
          {
            "op": "bounded-array",
            "path": "/resources",
            "min": 1,
            "max": 128
          },
          {
            "op": "all",
            "path": "/resources",
            "rules": [
              {
                "op": "exact-object",
                "keys": [
                  "digest",
                  "path"
                ]
              },
              {
                "op": "safe-relative-path",
                "path": "/path",
                "allow_root": true,
                "reserved_roots": [
                  ".git",
                  ".ledger"
                ],
                "case_insensitive_reserved": false
              },
              {
                "op": "digest",
                "path": "/digest"
              }
            ]
          },
          {
            "op": "sorted",
            "path": "/resources",
            "key": "/path"
          },
          {
            "op": "keyed-unique",
            "path": "/resources",
            "key": "/path"
          },
          {
            "op": "sha256",
            "mode": "framed-items",
            "field": "/contract_digest",
            "items": "/resources",
            "prefix": "actuating-lens-contract/v1\u0000",
            "fragments": [
              {
                "item": "/path"
              },
              {
                "literal": "\u0000"
              },
              {
                "item": "/digest"
              },
              {
                "literal": "\u0000"
              }
            ],
            "max_bytes": 262144
          }
        ]
      },
      {
        "op": "keyed-unique",
        "path": "/lens_contract_manifests",
        "key": "/name"
      },
      {
        "op": "exact-object",
        "path": "/review_contract",
        "keys": [
          "attempt_quality",
          "contract_digest",
          "contract_id",
          "initial_wave",
          "material_change",
          "required_lenses",
          "schema",
          "standard_convergence",
          "transport_recovery"
        ]
      },
      {
        "op": "enum",
        "path": "/review_contract/schema",
        "values": [
          "actuating-review-contract/v1"
        ]
      },
      {
        "op": "bounded-string",
        "path": "/review_contract/contract_id",
        "trimmed_min": 1,
        "max": 256
      },
      {
        "op": "digest",
        "path": "/review_contract/contract_digest"
      },
      {
        "op": "sha256",
        "path": "/review_contract",
        "mode": "canonical-json-null",
        "field": "/contract_digest",
        "null": "/contract_digest",
        "max_bytes": 524288
      },
      {
        "op": "bounded-array",
        "path": "/review_contract/required_lenses",
        "min": 1,
        "max": 64
      },
      {
        "op": "all",
        "path": "/review_contract/required_lenses",
        "rules": [
          {
            "op": "exact-object",
            "keys": [
              "contract_digest",
              "contract_ref",
              "name",
              "role"
            ]
          },
          {
            "op": "safe-identifier",
            "path": "/name",
            "min": 1,
            "max": 128,
            "style": "portable"
          },
          {
            "op": "bounded-string",
            "path": "/role",
            "trimmed_min": 1,
            "max": 128
          },
          {
            "op": "safe-relative-path",
            "path": "/contract_ref",
            "allow_root": true,
            "reserved_roots": [
              ".git",
              ".ledger"
            ],
            "case_insensitive_reserved": false
          },
          {
            "op": "digest",
            "path": "/contract_digest"
          }
        ]
      },
      {
        "op": "keyed-unique",
        "path": "/review_contract/required_lenses",
        "key": "/name"
      },
      {
        "op": "exact-object",
        "path": "/review_contract/initial_wave",
        "keys": [
          "all_lenses_required",
          "concurrent",
          "non_cancelling"
        ]
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/initial_wave/all_lenses_required",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/initial_wave/concurrent",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/initial_wave/non_cancelling",
        "type": "boolean"
      },
      {
        "op": "exact-object",
        "path": "/review_contract/standard_convergence",
        "keys": [
          "findings_reset_streak",
          "first_wave_standard_counts",
          "later_attempts_serial",
          "required_consecutive_clean_attempts"
        ]
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/standard_convergence/findings_reset_streak",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/standard_convergence/first_wave_standard_counts",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/standard_convergence/later_attempts_serial",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/standard_convergence/required_consecutive_clean_attempts",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "path": "/review_contract/standard_convergence/required_consecutive_clean_attempts",
        "min": 1
      },
      {
        "op": "exact-object",
        "path": "/review_contract/material_change",
        "keys": [
          "resets_all_review_credit"
        ]
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/material_change/resets_all_review_credit",
        "type": "boolean"
      },
      {
        "op": "exact-object",
        "path": "/review_contract/transport_recovery",
        "keys": [
          "maximum_fresh_recovery_attempts",
          "request_local"
        ]
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/transport_recovery/maximum_fresh_recovery_attempts",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "path": "/review_contract/transport_recovery/maximum_fresh_recovery_attempts",
        "min": 0
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/transport_recovery/request_local",
        "type": "boolean"
      },
      {
        "op": "exact-object",
        "path": "/review_contract/attempt_quality",
        "keys": [
          "context_match_required",
          "current_tuple_required",
          "exact_instruction_digest_required",
          "exact_workflow_binding_required",
          "fallback_forbidden",
          "reduced_principal_forbidden",
          "required_backend_class",
          "strong_principal_required",
          "structured_statuses",
          "tuple_verdict_required"
        ]
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/attempt_quality/context_match_required",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/attempt_quality/current_tuple_required",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/attempt_quality/exact_instruction_digest_required",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/attempt_quality/exact_workflow_binding_required",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/attempt_quality/fallback_forbidden",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/attempt_quality/reduced_principal_forbidden",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/attempt_quality/strong_principal_required",
        "type": "boolean"
      },
      {
        "op": "scalar-type",
        "path": "/review_contract/attempt_quality/tuple_verdict_required",
        "type": "boolean"
      },
      {
        "op": "bounded-string",
        "path": "/review_contract/attempt_quality/required_backend_class",
        "trimmed_min": 1,
        "max": 128
      },
      {
        "op": "bounded-array",
        "path": "/review_contract/attempt_quality/structured_statuses",
        "min": 1,
        "max": 64
      },
      {
        "op": "all",
        "path": "/review_contract/attempt_quality/structured_statuses",
        "rules": [
          {
            "op": "bounded-string",
            "trimmed_min": 1,
            "max": 128
          }
        ]
      },
      {
        "op": "unique",
        "path": "/review_contract/attempt_quality/structured_statuses"
      }
    ]
  },
  "constraints": [
    {
      "op": "reference-exists",
      "sources": [
        {
          "path": "/review_contract/required_lenses",
          "reference": "/name",
          "fragments": [
            {
              "item": "/name"
            },
            {
              "literal": "\u0000"
            },
            {
              "item": "/contract_ref"
            },
            {
              "literal": "\u0000"
            },
            {
              "item": "/contract_digest"
            }
          ]
        }
      ],
      "targets": [
        {
          "path": "/lens_contract_manifests",
          "fragments": [
            {
              "item": "/name"
            },
            {
              "literal": "\u0000"
            },
            {
              "item": "/contract_ref"
            },
            {
              "literal": "\u0000"
            },
            {
              "item": "/contract_digest"
            }
          ]
        }
      ],
      "coverage": "all-targets"
    },
    {
      "op": "reference-exists",
      "sources": [
        {
          "path": "/lens_contract_manifests",
          "reference": "/contract_ref",
          "fragments": [
            {
              "item": "/name"
            },
            {
              "literal": "\u0000"
            },
            {
              "value": true
            }
          ]
        }
      ],
      "targets": [
        {
          "path": "/lens_contract_manifests",
          "items": "/resources",
          "fragments": [
            {
              "parent": "/name"
            },
            {
              "literal": "\u0000"
            },
            {
              "item": "/path"
            }
          ]
        }
      ]
    }
  ],
  "identity": {},
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 8192,
    "max_output_bytes": 1048576,
    "max_diagnostics": 128,
    "max_reducer_states": 1
  }
}
