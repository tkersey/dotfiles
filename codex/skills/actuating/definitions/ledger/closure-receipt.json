{
  "schema": "ledger-artifact-definition/v1",
  "id": "actuating/closure-receipt",
  "owner": "actuating",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "bounded-array",
      "bounded-string",
      "canonical-json",
      "content-address",
      "digest",
      "enum",
      "exact-object",
      "one-of"
    ]
  },
  "inputs": {
    "receipt": {
      "codec": "json",
      "required": true,
      "max_bytes": 4194304
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "receipt"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "path": "",
        "keys": [
          "blockers",
          "cited_premise_refs",
          "closure_route",
          "construction_ref",
          "evidence_head",
          "goal_contract_ref",
          "receipt_id",
          "review_contract_digest",
          "schema",
          "subject_digest",
          "verdict"
        ]
      },
      {
        "op": "enum",
        "path": "/schema",
        "values": [
          "actuating-closure-receipt/v1"
        ]
      },
      {
        "op": "one-of",
        "path": "/receipt_id",
        "rules": [
          {
            "op": "enum",
            "values": [
              null
            ]
          },
          {
            "op": "digest"
          }
        ]
      },
      {
        "op": "digest",
        "path": "/goal_contract_ref"
      },
      {
        "op": "digest",
        "path": "/construction_ref"
      },
      {
        "op": "digest",
        "path": "/subject_digest"
      },
      {
        "op": "digest",
        "path": "/evidence_head"
      },
      {
        "op": "digest",
        "path": "/review_contract_digest"
      },
      {
        "op": "enum",
        "path": "/closure_route",
        "values": [
          "local-implementation",
          "final-closeout"
        ]
      },
      {
        "op": "enum",
        "path": "/verdict",
        "values": [
          "continue",
          "ready-to-ship",
          "complete",
          "blocked"
        ]
      },
      {
        "op": "bounded-array",
        "path": "/cited_premise_refs",
        "max": 1048576
      },
      {
        "op": "all",
        "path": "/cited_premise_refs",
        "rules": [
          {
            "op": "bounded-string",
            "trimmed_min": 1,
            "max": 4194304
          }
        ]
      },
      {
        "op": "bounded-array",
        "path": "/blockers",
        "max": 1048576
      },
      {
        "op": "all",
        "path": "/blockers",
        "rules": [
          {
            "op": "bounded-string",
            "trimmed_min": 1,
            "max": 4194304
          }
        ]
      }
    ]
  },
  "constraints": [],
  "identity": {
    "op": "content-address",
    "input": "receipt",
    "basis_null": "/receipt_id",
    "field": "/receipt_id"
  },
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 4194304,
    "max_store_bytes": 4194304,
    "max_records": 1048576,
    "max_output_bytes": 4194304,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
