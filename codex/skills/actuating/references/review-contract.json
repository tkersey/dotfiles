{
  "schema": "actuating-review-contract/v4",
  "contract_id": "actuating-review-contract-v6",
  "required_lenses": [
    {
      "name": "standard",
      "role": "standard",
      "instructions_ref": "codex/skills/actuating/references/standard-review.md"
    },
    {
      "name": "footgun-finder",
      "role": "auxiliary",
      "instructions_ref": "codex/skills/actuating/references/lenses/footgun-review.md"
    },
    {
      "name": "invariant-ace",
      "role": "auxiliary",
      "instructions_ref": "codex/skills/actuating/references/lenses/invariant-review.md"
    },
    {
      "name": "complexity-mitigator",
      "role": "auxiliary",
      "instructions_ref": "codex/skills/actuating/references/lenses/complexity-review.md"
    },
    {
      "name": "fresh-eyes",
      "role": "auxiliary",
      "instructions_ref": "codex/skills/actuating/references/lenses/fresh-eyes-review.md"
    }
  ],
  "review_scheduling": {
    "default_mode": "parallel-reviews",
    "request_local": true,
    "all_lenses_required": true,
    "initial_lens_order": [
      "standard",
      "footgun-finder",
      "invariant-ace",
      "complexity-mitigator",
      "fresh-eyes"
    ],
    "modes": {
      "parallel-reviews": {
        "dispatch": "concurrent",
        "non_cancelling": true,
        "terminal_barrier": true
      },
      "serial-reviews": {
        "dispatch": "serial",
        "adjudicate_before_next": true,
        "stop_before_next_on_material_change": true
      }
    }
  },
  "review_entry": {
    "complete_selected_construction_required": true,
    "complete_causal_basis_required": true,
    "complete_factor_disposition_required": true,
    "sibling_or_exhaustive_disposition_required": true,
    "strongest_relevant_validation_required": true,
    "closure_review_as_construction_forbidden": true
  },
  "material_finding_transition": {
    "exits_convergence": true,
    "parallel_terminal_barrier_before_mutation": true,
    "serial_stop_before_next_request": true,
    "confirmation_stop_before_next_attempt": true,
    "complete_current_class_fold_required": true,
    "arrival_order_invariant_target_required": true,
    "review_closed_during_realization": true,
    "redispatch_requires_complete_realization_and_proof": true,
    "direct_repair_materialization_scope": "complete-epoch-target"
  },
  "same_generator_recurrence": {
    "member_enumeration_forbidden_without_separation": true,
    "generative_or_exhaustive_evidence_required_to_retain_family": true,
    "otherwise_reconsider_theory_or_architecture": true
  },
  "standard_convergence": {
    "required_consecutive_clean_attempts": 5,
    "initial_standard_counts": true,
    "later_attempts_serial": true,
    "findings_reset_streak": true
  },
  "material_change": {
    "identity": "git-head",
    "resets_all_review_credit": true,
    "restarts_selected_schedule_from_initial_standard": true
  },
  "transport_recovery": {
    "request_local": true,
    "maximum_fresh_recovery_attempts": 1
  },
  "attempt_quality": {
    "tuple_verdict_required": true,
    "strong_principal_required": true,
    "reduced_principal_forbidden": true,
    "fallback_forbidden": true,
    "owner_lived_transport_required": true,
    "context_match_required": true,
    "exact_instruction_digest_required": true,
    "exact_workflow_binding_required": true,
    "current_tuple_required": true,
    "required_backend_class": "cas-start-wait",
    "required_capability": "cas_workflow_bound_owner_lived_review_v1",
    "structured_statuses": [
      "clean",
      "findings"
    ]
  }
}
