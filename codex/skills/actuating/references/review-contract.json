{
  "schema": "actuating-review-contract/v7",
  "contract_id": "actuating-review-contract-v9",
  "required_lenses": [
    {
      "name": "standard",
      "role": "standard",
      "instructions_ref": "codex/skills/actuating/references/standard-review.md"
    },
    {
      "name": "footgun-finder",
      "role": "auxiliary",
      "instructions_ref": "codex/skills/actuating/references/lenses/footgun-review.md"
    },
    {
      "name": "invariant-ace",
      "role": "auxiliary",
      "instructions_ref": "codex/skills/actuating/references/lenses/invariant-review.md"
    },
    {
      "name": "complexity-mitigator",
      "role": "auxiliary",
      "instructions_ref": "codex/skills/actuating/references/lenses/complexity-review.md"
    },
    {
      "name": "fresh-eyes",
      "role": "auxiliary",
      "instructions_ref": "codex/skills/actuating/references/lenses/fresh-eyes-review.md"
    }
  ],
  "review_scheduling": {
    "default_mode": "parallel-reviews",
    "request_local": true,
    "all_lenses_required": true,
    "initial_lens_order": [
      "standard",
      "footgun-finder",
      "invariant-ace",
      "complexity-mitigator",
      "fresh-eyes"
    ],
    "modes": {
      "parallel-reviews": {
        "dispatch": "concurrent",
        "non_cancelling": true,
        "terminal_transport_barrier": true,
        "semantic_outcome_barrier_before_evidence_cut": true
      },
      "serial-reviews": {
        "dispatch": "serial",
        "adjudicate_before_next": true,
        "stop_before_next_on_material_finding": true
      }
    }
  },
  "candidate_lifecycle": {
    "derived_not_stored": true,
    "states": [
      "realizing",
      "reviewable",
      "invalidated"
    ],
    "review_dispatch_requires": "reviewable",
    "initial_and_successor_entry_require_same_complete_proof": true,
    "reviewable_requires_complete_selected_construction": true,
    "reviewable_requires_complete_factor_disposition": true,
    "reviewable_requires_complete_goal_proof_inventory": true,
    "reviewable_requires_exact_head_proof_results": true,
    "material_finding_invalidates_candidate_immediately": true,
    "reconciliation_epoch_is_derived_interval": true,
    "reconciliation_epoch_starts": "candidate-invalidation",
    "reconciliation_epoch_ends": "successor-reviewable"
  },
  "review_entry": {
    "complete_selected_construction_required": true,
    "complete_causal_basis_required": true,
    "complete_factor_disposition_required": true,
    "sibling_or_exhaustive_disposition_required": true,
    "complete_goal_required_proof_inventory_required": true,
    "allowed_proof_dispositions": [
      "passed",
      "not-applicable"
    ],
    "nonapplicability_requires_authority": true,
    "aggregate_credit_requires_declared_dependency_coverage": true,
    "first_run_required_proof_after_review_forbidden": true,
    "closure_review_as_construction_forbidden": true
  },
  "material_finding_transition": {
    "candidate_invalidated_immediately": true,
    "parallel_evidence_cut_requires_all_launched_semantic_outcomes": true,
    "required_recovery_completes_before_evidence_cut": true,
    "serial_stop_before_next_request": true,
    "confirmation_stop_before_next_attempt": true,
    "complete_current_class_fold_required": true,
    "complete_causal_basis_required": true,
    "complete_factor_disposition_required": true,
    "sibling_or_exhaustive_disposition_required": true,
    "successor_disposition_scope": "per-causal-generator",
    "mixed_generator_dispositions_allowed": true,
    "arrival_order_invariant_within_closed_cut": true,
    "review_closed_until_successor_reviewable": true,
    "direct_repair_materialization_scope": "one-complete-causal-generator",
    "maximum_direct_repair_materializations_per_generator": 1,
    "generator_gate_binds_starting_predecessor": true,
    "generator_gate_spans_coherent_commits_until_generator_complete": true,
    "later_generator_gate_binds_current_predecessor": true,
    "finding_local_direct_repair_materialization_forbidden": true
  },
  "same_generator_recurrence": {
    "member_enumeration_forbidden_without_separation": true,
    "generative_or_exhaustive_evidence_required_to_retain_family": true,
    "otherwise_reconsider_theory_or_architecture": true
  },
  "standard_convergence": {
    "required_consecutive_clean_attempts": 5,
    "initial_standard_counts": true,
    "later_attempts_serial": true,
    "findings_reset_streak": true
  },
  "material_change": {
    "identity": "git-head",
    "resets_all_review_credit": true,
    "restarts_selected_schedule_from_initial_standard": true,
    "restart_requires_successor_reviewable": true
  },
  "transport_recovery": {
    "request_local": true,
    "maximum_fresh_recovery_attempts": 1,
    "required_recovery_is_part_of_semantic_barrier": true
  },
  "attempt_quality": {
    "tuple_verdict_required": true,
    "strong_principal_required": true,
    "reduced_principal_forbidden": true,
    "fallback_forbidden": true,
    "owner_lived_transport_required": true,
    "context_match_required": true,
    "exact_instruction_digest_required": true,
    "exact_workflow_binding_required": true,
    "current_tuple_required": true,
    "required_backend_class": "cas-start-wait",
    "required_capability": "cas_workflow_bound_owner_lived_review_v1",
    "structured_statuses": [
      "clean",
      "findings"
    ]
  }
}
