{
  "schema": "actuating-review-mutation-epoch-scenarios/v1",
  "defaults": {
    "schedule": "parallel",
    "material_finding": true,
    "required_terminal_barrier_complete": true,
    "all_applicable_classes_folded": true,
    "causal_basis_complete": true,
    "sibling_disposition": "passed",
    "selected_target_stated": true,
    "direct_repair_selected": false,
    "direct_repair_gate_materialized": false,
    "selected_target_completely_realized": false,
    "strongest_validation_passed": false,
    "same_generator_recurrence": false,
    "proposed_member_enumeration": false,
    "separation_proof": false,
    "generative_family_evidence": false
  },
  "scenarios": [
    {
      "id": "clean-review-continues",
      "inputs": { "material_finding": false },
      "expected": {
        "phase": "review",
        "mutation": "forbidden",
        "redispatch": "continue-current",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "parallel-material-finding-waits-for-barrier",
      "inputs": { "required_terminal_barrier_complete": false },
      "expected": {
        "phase": "await-barrier",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "serial-material-finding-stops-before-next",
      "inputs": {
        "schedule": "serial",
        "required_terminal_barrier_complete": false
      },
      "expected": {
        "phase": "await-barrier",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "confirmation-finding-exits-convergence",
      "inputs": {
        "schedule": "confirmation",
        "all_applicable_classes_folded": false
      },
      "expected": {
        "phase": "reconcile",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "incomplete-causal-basis-blocks-mutation",
      "inputs": { "causal_basis_complete": false },
      "expected": {
        "phase": "reconcile",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "missing-sibling-disposition-blocks-mutation",
      "inputs": { "sibling_disposition": "missing" },
      "expected": {
        "phase": "reconcile",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "unstated-target-blocks-mutation",
      "inputs": { "selected_target_stated": false },
      "expected": {
        "phase": "reconcile",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "direct-repair-awaits-one-epoch-gate",
      "inputs": { "direct_repair_selected": true },
      "expected": {
        "phase": "await-direct-gate",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "complete-epoch-target"
      }
    },
    {
      "id": "complete-direct-repair-epoch",
      "inputs": {
        "direct_repair_selected": true,
        "direct_repair_gate_materialized": true
      },
      "expected": {
        "phase": "realize",
        "mutation": "epoch-target",
        "redispatch": "forbidden",
        "direct_gate_scope": "complete-epoch-target"
      }
    },
    {
      "id": "realized-target-awaits-validation",
      "inputs": { "selected_target_completely_realized": true },
      "expected": {
        "phase": "realize",
        "mutation": "complete",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "realized-epoch-restarts-once",
      "inputs": {
        "selected_target_completely_realized": true,
        "strongest_validation_passed": true
      },
      "expected": {
        "phase": "redispatch-ready",
        "mutation": "complete",
        "redispatch": "restart-selected-schedule",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "same-generator-member-enumeration-reopens-architecture",
      "inputs": {
        "same_generator_recurrence": true,
        "proposed_member_enumeration": true
      },
      "expected": {
        "phase": "reconsider-architecture",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "same-generator-without-family-evidence-reopens-architecture",
      "inputs": {
        "same_generator_recurrence": true,
        "proposed_member_enumeration": false
      },
      "expected": {
        "phase": "reconsider-architecture",
        "mutation": "forbidden",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "same-generator-separated-obligation",
      "inputs": {
        "same_generator_recurrence": true,
        "proposed_member_enumeration": true,
        "separation_proof": true
      },
      "expected": {
        "phase": "realize",
        "mutation": "epoch-target",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "same-generator-generative-repair",
      "inputs": {
        "same_generator_recurrence": true,
        "proposed_member_enumeration": false,
        "generative_family_evidence": true
      },
      "expected": {
        "phase": "realize",
        "mutation": "epoch-target",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    },
    {
      "id": "no-meaningful-sibling-probe-still-explicit",
      "inputs": { "sibling_disposition": "not-meaningful" },
      "expected": {
        "phase": "realize",
        "mutation": "epoch-target",
        "redispatch": "forbidden",
        "direct_gate_scope": "not-applicable"
      }
    }
  ]
}
