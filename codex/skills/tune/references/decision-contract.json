{
  "skill_decision_contract": {
    "contract_version": "SKDC-v1",
    "skill": {
      "name": "tune",
      "kind": "mixed",
      "source_fingerprint": "unified-create-edit-evidence-tune-v3"
    },
    "triggers": [
      {
        "trigger_id": "TUNE-CREATE-REQUEST",
        "description": "The user requests a new Codex skill and no existing skill is yet known to own the intent.",
        "cue_literals": [
          "create a skill",
          "new skill",
          "$tune create"
        ],
        "cue_regexes": [],
        "exclusions": [
          "update an existing skill",
          "analyze existing skill behavior"
        ]
      },
      {
        "trigger_id": "TUNE-DIRECT-EDIT",
        "description": "The user identifies an existing skill and a concrete package change or known defect.",
        "cue_literals": [
          "edit the skill",
          "update the skill",
          "fix the skill",
          "$tune edit"
        ],
        "cue_regexes": [],
        "exclusions": [
          "what should change",
          "do not edit"
        ]
      },
      {
        "trigger_id": "TUNE-EVIDENCE-QUESTION",
        "description": "The user asks whether, why, or how an existing skill should change from observed use, outcomes, or a regression.",
        "cue_literals": [
          "intended-vs-observed",
          "missed activation",
          "false activation",
          "skill regression",
          "$tune tune"
        ],
        "cue_regexes": [],
        "exclusions": [
          "specified wording replacement only"
        ]
      }
    ],
    "routes": [
      {
        "route_id": "TUNE-CREATE",
        "description": "Create one lean skill package after confirming no existing owner covers the intent.",
        "aliases": [
          "create"
        ],
        "terminal": false
      },
      {
        "route_id": "TUNE-EDIT",
        "description": "Apply one coherent authorized intervention to an existing skill package.",
        "aliases": [
          "edit",
          "apply"
        ],
        "terminal": false
      },
      {
        "route_id": "TUNE-PROPOSE",
        "description": "Return one bounded expected delta and intervention without mutation.",
        "aliases": [
          "proposal",
          "inspect"
        ],
        "terminal": true
      },
      {
        "route_id": "TUNE-NO-ACTION",
        "description": "Stop because an existing owner already covers creation intent, the package already satisfies the request, or no consequential delta is supported.",
        "aliases": [
          "no-change",
          "retire"
        ],
        "terminal": true
      },
      {
        "route_id": "TUNE-BLOCKED",
        "description": "Stop because required target, authority, evidence, expected delta, or package boundary is missing.",
        "aliases": [
          "blocked"
        ],
        "terminal": true
      }
    ],
    "clauses": [
      {
        "clause_id": "TUNE-CREATE-001",
        "trigger_refs": [
          "TUNE-CREATE-REQUEST"
        ],
        "expected_routes": [
          "TUNE-CREATE",
          "TUNE-PROPOSE",
          "TUNE-NO-ACTION",
          "TUNE-BLOCKED"
        ],
        "prohibited_routes": [
          "TUNE-EDIT"
        ],
        "required_artifacts": [
          "existing-skill check",
          "trigger and non-trigger boundary",
          "progressive-disclosure map"
        ],
        "success_signals": [
          "one lean package or an identified existing owner",
          "aligned SKILL.md and agents/openai.yaml"
        ],
        "failure_signals": [
          "synonym skill created without search",
          "instrumentation added without a decision need"
        ],
        "rationale": "Creation begins from an uncovered capability, not a preferred new package name."
      },
      {
        "clause_id": "TUNE-EDIT-001",
        "trigger_refs": [
          "TUNE-DIRECT-EDIT"
        ],
        "expected_routes": [
          "TUNE-EDIT",
          "TUNE-PROPOSE",
          "TUNE-NO-ACTION",
          "TUNE-BLOCKED"
        ],
        "prohibited_routes": [
          "TUNE-CREATE"
        ],
        "required_artifacts": [
          "expected delta",
          "protected behavior",
          "mutation authority"
        ],
        "success_signals": [
          "one coherent authorized intervention",
          "stable contract IDs preserved"
        ],
        "failure_signals": [
          "historical dossier manufactured for a known direct edit",
          "unrelated package rewrite"
        ],
        "rationale": "A known skill change should proceed directly without inter-skill handoff ceremony."
      },
      {
        "clause_id": "TUNE-EVIDENCE-001",
        "trigger_refs": [
          "TUNE-EVIDENCE-QUESTION"
        ],
        "expected_routes": [
          "TUNE-EDIT",
          "TUNE-PROPOSE",
          "TUNE-NO-ACTION",
          "TUNE-BLOCKED"
        ],
        "prohibited_routes": [
          "TUNE-CREATE"
        ],
        "required_artifacts": [
          "evidence source and limits",
          "expected decision or execution delta",
          "outcome observation"
        ],
        "success_signals": [
          "activation, decision influence, and outcome causality remain distinct",
          "one dominant delta or no-change"
        ],
        "failure_signals": [
          "raw mention treated as activation",
          "successful outcome treated as causal proof",
          "broad edit from weak evidence"
        ],
        "rationale": "Evidence-backed tuning must diagnose a consequential gap before mutation."
      },
      {
        "clause_id": "TUNE-SELECTION-001",
        "trigger_refs": [
          "TUNE-DIRECT-EDIT",
          "TUNE-EVIDENCE-QUESTION"
        ],
        "expected_routes": [
          "TUNE-EDIT",
          "TUNE-PROPOSE",
          "TUNE-NO-ACTION",
          "TUNE-BLOCKED"
        ],
        "prohibited_routes": [
          "TUNE-CREATE"
        ],
        "required_artifacts": [
          "validity gate",
          "semantic-weakness basis or single-candidate justification",
          "physical realization basis"
        ],
        "success_signals": [
          "weakest valid intervention supportable by current evidence",
          "physical size considered only after semantic selection"
        ],
        "failure_signals": [
          "description length used as a generalization proxy",
          "unnecessary global rule",
          "incomparability silently collapsed"
        ],
        "rationale": "Tune changes no more future behavior than the requested or evidenced delta requires."
      }
    ],
    "instrumentation": {
      "decision_receipt": "optional",
      "rationale": "Use SDR-v1 only for consequential route decisions that bounded traces cannot recover proportionately."
    }
  }
}
