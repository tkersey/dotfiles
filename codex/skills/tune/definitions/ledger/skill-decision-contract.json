{
  "schema": "ledger-artifact-definition/v1",
  "id": "tune/skill-decision-contract",
  "owner": "tune",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "bounded-array",
      "bounded-string",
      "disjoint",
      "enum",
      "exact-object",
      "keyed-unique",
      "reference-exists",
      "safe-identifier",
      "unique"
    ]
  },
  "parameters": {},
  "inputs": {
    "contract": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {},
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "contract",
        "path": "",
        "keys": [
          "skill_decision_contract"
        ]
      },
      {
        "op": "exact-object",
        "input": "contract",
        "path": "/skill_decision_contract",
        "keys": [
          "clauses",
          "contract_version",
          "instrumentation",
          "routes",
          "skill",
          "triggers"
        ]
      },
      {
        "op": "enum",
        "input": "contract",
        "path": "/skill_decision_contract/contract_version",
        "values": [
          "SKDC-v1"
        ]
      },
      {
        "op": "exact-object",
        "input": "contract",
        "path": "/skill_decision_contract/skill",
        "keys": [
          "kind",
          "name",
          "source_fingerprint"
        ]
      },
      {
        "op": "safe-identifier",
        "input": "contract",
        "path": "/skill_decision_contract/skill/name",
        "max": 128
      },
      {
        "op": "enum",
        "input": "contract",
        "path": "/skill_decision_contract/skill/kind",
        "values": [
          "decision",
          "evidence",
          "execution",
          "mixed",
          "orchestration"
        ]
      },
      {
        "op": "bounded-string",
        "input": "contract",
        "path": "/skill_decision_contract/skill/source_fingerprint",
        "min": 1,
        "max": 256
      },
      {
        "op": "bounded-array",
        "input": "contract",
        "path": "/skill_decision_contract/triggers",
        "min": 1,
        "max": 128
      },
      {
        "op": "all",
        "input": "contract",
        "path": "/skill_decision_contract/triggers",
        "rules": [
          {
            "op": "exact-object",
            "keys": [
              "cue_literals",
              "cue_regexes",
              "description",
              "exclusions",
              "trigger_id"
            ]
          },
          {
            "op": "safe-identifier",
            "path": "/trigger_id",
            "max": 128
          },
          {
            "op": "bounded-string",
            "path": "/description",
            "min": 1,
            "max": 4096
          },
          {
            "op": "bounded-array",
            "path": "/cue_literals",
            "max": 256
          },
          {
            "op": "unique",
            "path": "/cue_literals"
          },
          {
            "op": "all",
            "path": "/cue_literals",
            "rules": [
              {
                "op": "bounded-string",
                "min": 1,
                "max": 2048
              }
            ]
          },
          {
            "op": "bounded-array",
            "path": "/cue_regexes",
            "max": 256
          },
          {
            "op": "unique",
            "path": "/cue_regexes"
          },
          {
            "op": "all",
            "path": "/cue_regexes",
            "rules": [
              {
                "op": "bounded-string",
                "min": 1,
                "max": 2048
              }
            ]
          },
          {
            "op": "bounded-array",
            "path": "/exclusions",
            "max": 256
          },
          {
            "op": "unique",
            "path": "/exclusions"
          },
          {
            "op": "all",
            "path": "/exclusions",
            "rules": [
              {
                "op": "bounded-string",
                "min": 1,
                "max": 2048
              }
            ]
          }
        ]
      },
      {
        "op": "keyed-unique",
        "input": "contract",
        "path": "/skill_decision_contract/triggers",
        "key": "/trigger_id"
      },
      {
        "op": "bounded-array",
        "input": "contract",
        "path": "/skill_decision_contract/routes",
        "min": 1,
        "max": 128
      },
      {
        "op": "all",
        "input": "contract",
        "path": "/skill_decision_contract/routes",
        "rules": [
          {
            "op": "exact-object",
            "keys": [
              "aliases",
              "description",
              "route_id",
              "terminal"
            ]
          },
          {
            "op": "safe-identifier",
            "path": "/route_id",
            "max": 128
          },
          {
            "op": "bounded-string",
            "path": "/description",
            "min": 1,
            "max": 4096
          },
          {
            "op": "bounded-array",
            "path": "/aliases",
            "max": 256
          },
          {
            "op": "unique",
            "path": "/aliases"
          },
          {
            "op": "all",
            "path": "/aliases",
            "rules": [
              {
                "op": "bounded-string",
                "min": 1,
                "max": 256
              }
            ]
          },
          {
            "op": "enum",
            "path": "/terminal",
            "values": [
              false,
              true
            ]
          }
        ]
      },
      {
        "op": "keyed-unique",
        "input": "contract",
        "path": "/skill_decision_contract/routes",
        "key": "/route_id"
      },
      {
        "op": "bounded-array",
        "input": "contract",
        "path": "/skill_decision_contract/clauses",
        "min": 1,
        "max": 256
      },
      {
        "op": "all",
        "input": "contract",
        "path": "/skill_decision_contract/clauses",
        "rules": [
          {
            "op": "exact-object",
            "keys": [
              "clause_id",
              "expected_routes",
              "failure_signals",
              "prohibited_routes",
              "rationale",
              "required_artifacts",
              "success_signals",
              "trigger_refs"
            ]
          },
          {
            "op": "safe-identifier",
            "path": "/clause_id",
            "max": 128
          },
          {
            "op": "bounded-array",
            "path": "/trigger_refs",
            "min": 1,
            "max": 128
          },
          {
            "op": "bounded-array",
            "path": "/expected_routes",
            "min": 1,
            "max": 128
          },
          {
            "op": "bounded-array",
            "path": "/prohibited_routes",
            "max": 128
          },
          {
            "op": "bounded-array",
            "path": "/required_artifacts",
            "max": 256
          },
          {
            "op": "bounded-array",
            "path": "/success_signals",
            "max": 256
          },
          {
            "op": "bounded-array",
            "path": "/failure_signals",
            "max": 256
          },
          {
            "op": "all",
            "path": "/trigger_refs",
            "rules": [
              {
                "op": "safe-identifier",
                "max": 128
              }
            ]
          },
          {
            "op": "all",
            "path": "/expected_routes",
            "rules": [
              {
                "op": "safe-identifier",
                "max": 128
              }
            ]
          },
          {
            "op": "all",
            "path": "/prohibited_routes",
            "rules": [
              {
                "op": "safe-identifier",
                "max": 128
              }
            ]
          },
          {
            "op": "all",
            "path": "/required_artifacts",
            "rules": [
              {
                "op": "bounded-string",
                "min": 1,
                "max": 2048
              }
            ]
          },
          {
            "op": "all",
            "path": "/success_signals",
            "rules": [
              {
                "op": "bounded-string",
                "min": 1,
                "max": 2048
              }
            ]
          },
          {
            "op": "all",
            "path": "/failure_signals",
            "rules": [
              {
                "op": "bounded-string",
                "min": 1,
                "max": 2048
              }
            ]
          },
          {
            "op": "unique",
            "path": "/trigger_refs"
          },
          {
            "op": "unique",
            "path": "/expected_routes"
          },
          {
            "op": "unique",
            "path": "/prohibited_routes"
          },
          {
            "op": "bounded-string",
            "path": "/rationale",
            "min": 1,
            "max": 4096
          },
          {
            "op": "disjoint",
            "left": "/expected_routes",
            "right": "/prohibited_routes"
          }
        ]
      },
      {
        "op": "keyed-unique",
        "input": "contract",
        "path": "/skill_decision_contract/clauses",
        "key": "/clause_id"
      },
      {
        "op": "exact-object",
        "input": "contract",
        "path": "/skill_decision_contract/instrumentation",
        "keys": [
          "decision_receipt",
          "rationale"
        ]
      },
      {
        "op": "enum",
        "input": "contract",
        "path": "/skill_decision_contract/instrumentation/decision_receipt",
        "values": [
          "not-needed",
          "optional",
          "required"
        ]
      },
      {
        "op": "bounded-string",
        "input": "contract",
        "path": "/skill_decision_contract/instrumentation/rationale",
        "min": 1,
        "max": 4096
      }
    ]
  },
  "constraints": [
    {
      "op": "reference-exists",
      "input": "contract",
      "path": "/skill_decision_contract/clauses",
      "reference": "/trigger_refs",
      "target": "/skill_decision_contract/triggers",
      "key": "/trigger_id"
    },
    {
      "op": "reference-exists",
      "input": "contract",
      "path": "/skill_decision_contract/clauses",
      "reference": "/expected_routes",
      "target": "/skill_decision_contract/routes",
      "key": "/route_id"
    },
    {
      "op": "reference-exists",
      "input": "contract",
      "path": "/skill_decision_contract/clauses",
      "reference": "/prohibited_routes",
      "target": "/skill_decision_contract/routes",
      "key": "/route_id"
    }
  ],
  "identity": {},
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 4096,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
