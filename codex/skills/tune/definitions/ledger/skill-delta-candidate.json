      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "candidate"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "candidate",
        "path": "",
        "keys": [
          "skill_delta_candidate"
        ]
      },
      {
        "op": "exact-object",
        "input": "candidate",
        "path": "/skill_delta_candidate",
        "required_keys": [
          "candidate_version",
          "expected_decision_delta",
          "gap",
          "outcome_observation",
          "proposed_action",
          "protected_contracts",
          "smallest_change",
          "source_packet",
          "target_kind",
          "target_skill"
        ],
        "optional_keys": [
          "publication"
        ],
        "allow_additional": false
      },
      {
        "op": "enum",
        "input": "candidate",
        "path": "/skill_delta_candidate/candidate_version",
        "values": [
          "SDC-v2"
        ]
      },
      {
        "op": "safe-identifier",
        "input": "candidate",
        "path": "/skill_delta_candidate/target_skill",
        "max": 128
      },
      {
        "op": "enum",
        "input": "candidate",
        "path": "/skill_delta_candidate/target_kind",
        "values": [
