{
  "schema": "ledger-artifact-definition/v1",
  "id": "tune/skill-delta-candidate",
  "owner": "tune",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "bounded-array",
      "bounded-number",
      "bounded-string",
      "canonical-json",
      "content-address",
      "digest",
      "enum",
      "exact-object",
      "optional-field",
      "safe-identifier",
      "scalar-type",
      "unique"
    ]
  },
  "parameters": {},
  "inputs": {
    "candidate": {
