      },
      {
        "op": "bounded-number",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/recurrence",
        "min": 1
      },
      {
        "op": "enum",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/confidence",
        "values": [
          "high",
          "low",
          "medium"
        ]
      },
      {
        "op": "bounded-string",
        "input": "candidate",
        "path": "/skill_delta_candidate/expected_decision_delta",
        "trimmed_min": 1,
        "max": 65536
      },
      {
        "op": "bounded-string",
        "input": "candidate",
        "path": "/skill_delta_candidate/smallest_change",
        "trimmed_min": 1,
        "max": 65536
      },
      {
        "op": "bounded-array",
        "input": "candidate",
        "path": "/skill_delta_candidate/protected_contracts",
        "max": 4096
      },
      {
        "op": "all",
        "input": "candidate",
        "path": "/skill_delta_candidate/protected_contracts",
        "rules": [
          {
            "op": "bounded-string",
            "path": "",
            "trimmed_min": 1,
            "max": 1024
          }
        ]
      },
      {
        "op": "unique",
        "input": "candidate",
        "path": "/skill_delta_candidate/protected_contracts"
      },
      {
        "op": "bounded-string",
        "input": "candidate",
        "path": "/skill_delta_candidate/outcome_observation",
        "trimmed_min": 1,
        "max": 65536
      },
      {
        "op": "enum",
        "input": "candidate",
        "path": "/skill_delta_candidate/proposed_action",
        "values": [
          "apply-with-refine",
          "audit-only",
          "no-action",
          "proposal-only",
          "retire",
          "transfer"
        ]
      },
      {
        "op": "optional-field",
        "input": "candidate",
        "path": "/skill_delta_candidate/publication",
        "rules": [
          {
            "op": "exact-object",
            "path": "",
            "keys": [
              "authorization",
              "commit_state",
              "push_state"
            ]
          },
          {
            "op": "enum",
            "path": "/authorization",
            "values": [
              "commit-and-push",
              "commit-only",
              "none"
            ]
          },
          {
            "op": "bounded-string",
            "path": "/commit_state",
            "trimmed_min": 1,
            "max": 1024
          },
          {
            "op": "bounded-string",
            "path": "/push_state",
            "trimmed_min": 1,
            "max": 1024
          }
        ]
      }
    ]
  },
  "constraints": [],
  "identity": {
    "op": "content-address",
    "input": "candidate"
  },
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 4096,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
