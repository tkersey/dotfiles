      {
        "op": "digest",
        "input": "candidate",
        "path": "/skill_delta_candidate/source_packet/definition_digest"
      },
      {
        "op": "digest",
        "input": "candidate",
        "path": "/skill_delta_candidate/source_packet/content_digest"
      },
      {
