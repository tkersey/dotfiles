        "op": "safe-identifier",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/signature",
        "max": 256
      },
      {
        "op": "enum",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/type",
        "values": [
          "activation",
          "boundary",
          "ceremony",
          "decision-contract",
          "interpretation",
          "metadata",
          "observability",
          "outcome",
          "overconstraint",
          "resource",
          "source-scope",
          "tooling",
          "workflow"
        ]
      },
      {
        "op": "bounded-array",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/episode_refs",
        "max": 4096
      },
      {
        "op": "all",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/episode_refs",
        "rules": [
          {
            "op": "bounded-string",
            "path": "",
            "trimmed_min": 1,
            "max": 512
          }
        ]
      },
      {
        "op": "unique",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/episode_refs"
      },
      {
        "op": "bounded-array",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/clause_refs",
        "max": 4096
      },
      {
        "op": "all",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/clause_refs",
        "rules": [
          {
            "op": "bounded-string",
            "path": "",
            "trimmed_min": 1,
            "max": 512
          }
        ]
      },
      {
        "op": "unique",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/clause_refs"
      },
      {
        "op": "enum",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/evidence_class",
        "values": [
          "associated",
          "explicit",
          "inferred",
          "strong",
          "unknown"
        ]
      },
      {
        "op": "scalar-type",
        "input": "candidate",
        "path": "/skill_delta_candidate/gap/recurrence",
