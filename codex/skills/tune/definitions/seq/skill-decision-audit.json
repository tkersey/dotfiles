{
  "schema": "seq-observation-definition/v1",
  "id": "tune/skill-decision-audit",
  "requires": {
    "abi": "seq-observation-abi/v1",
    "operators": [
      "filter",
      "limit",
      "project",
      "scan",
      "sort"
    ]
  },
  "parameters": {
    "needle": {
      "type": "string",
      "required": true
    }
  },
  "selectors": [
    "root",
    "session-id",
    "path",
    "repo",
    "since",
    "until",
    "last"
  ],
  "relations": [
    {
      "name": "source_events",
      "fields": [
        "source_event_id",
        "session_id",
        "path",
        "line_number",
        "entry_type",
        "event_type",
        "timestamp",
        "turn_index",
        "role",
        "text",
        "private"
      ]
    },
    {
      "name": "tool_lifecycle",
      "fields": [
        "call_id",
        "session_id",
        "turn_index",
        "started_at",
        "completed_at",
        "kind",
        "tool_name",
        "namespace",
        "arguments_json",
        "input_text",
        "command_text",
        "cwd",
        "output_text",
        "exit_code",
        "lifecycle_status",
        "path"
      ]
    }
  ],
  "inputs": [],
  "pipeline": [
    {
      "op": "scan",
      "relation": "source_events",
      "as": "source"
    },
    {
      "op": "filter",
      "input": "source",
      "as": "matched",
      "where": [
        {
          "field": "private",
          "op": "exact",
          "value": false
        },
        {
          "field": "text",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        }
      ]
    },
    {
      "op": "sort",
      "input": "matched",
      "as": "newest",
      "by": [
        {
          "field": "timestamp",
          "direction": "desc",
          "nulls": "last"
        },
        {
          "field": "path",
          "direction": "desc"
        },
        {
          "field": "line_number",
          "direction": "desc"
        }
      ]
    },
    {
      "op": "limit",
      "input": "newest",
      "as": "bounded",
      "limit": 2000
    },
    {
      "op": "project",
      "input": "bounded",
      "as": "evidence",
      "fields": [
        "source_event_id",
        "session_id",
        "path",
        "line_number",
        "entry_type",
        "event_type",
        "timestamp",
        "turn_index",
        "role",
        "text",
        "private"
      ]
    },
    {
      "op": "scan",
      "relation": "tool_lifecycle",
      "as": "tools_source"
    },
    {
      "op": "filter",
      "input": "tools_source",
      "as": "matched_tools",
      "where_mode": "any",
      "where": [
        {
          "field": "tool_name",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "namespace",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "arguments_json",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "input_text",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "command_text",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        }
      ]
    },
    {
      "op": "sort",
      "input": "matched_tools",
      "as": "newest_tools",
      "by": [
        {
          "field": "started_at",
          "direction": "desc",
          "nulls": "last"
        },
        {
          "field": "path",
          "direction": "desc"
        },
        {
          "field": "turn_index",
          "direction": "desc",
          "nulls": "last"
        }
      ]
    },
    {
      "op": "limit",
      "input": "newest_tools",
      "as": "bounded_tools",
      "limit": 2000
    },
    {
      "op": "project",
      "input": "bounded_tools",
      "as": "tool_evidence",
      "fields": [
        "call_id",
        "session_id",
        "turn_index",
        "started_at",
        "completed_at",
        "kind",
        "tool_name",
        "namespace",
        "arguments_json",
        "input_text",
        "command_text",
        "cwd",
        "output_text",
        "exit_code",
        "lifecycle_status",
        "path"
      ]
    }
  ],
  "projections": {
    "evidence": {
      "relation": "evidence",
      "schema": "tune-skill-decision-evidence/v1",
      "fields": [
        "source_event_id",
        "session_id",
        "path",
        "line_number",
        "entry_type",
        "event_type",
        "timestamp",
        "turn_index",
        "role",
        "text",
        "private"
      ],
      "renderers": [
        "json"
      ]
    },
    "tools": {
      "relation": "tool_evidence",
      "schema": "tune-skill-decision-tool-evidence/v1",
      "fields": [
        "call_id",
        "session_id",
        "turn_index",
        "started_at",
        "completed_at",
        "kind",
        "tool_name",
        "namespace",
        "arguments_json",
        "input_text",
        "command_text",
        "cwd",
        "output_text",
        "exit_code",
        "lifecycle_status",
        "path"
      ],
      "renderers": [
        "json"
      ]
    }
  },
  "bounds": {
    "max_rows": 2000,
    "max_output_bytes": 16777216,
    "max_fold_states": 1
  }
}
