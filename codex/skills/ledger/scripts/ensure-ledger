#!/usr/bin/env bash

set -euo pipefail

readonly DEFAULT_FORMULA="tkersey/tap/ledger"

formula="${LEDGER_BOOTSTRAP_FORMULA:-$DEFAULT_FORMULA}"
install_allowed=false

usage() {
  cat <<'EOF'
ensure-ledger

usage:
  ensure-ledger [--install]

Ensures a ledger command resolves on PATH. With --install, installs the native
Ledger CLI's Homebrew formula when ledger is missing or upgrades it when the
installed CLI does not satisfy readiness. Readiness requires Ledger 1.1.0 or
newer within major version 1 and ledger-artifact-abi/v1. The handler does not
proxy native commands.
EOF
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

emit_error() {
  local reason="$1"
  local remediation="$2"
  printf '{"schema":"ledger-bootstrap-error/v1","status":"blocked","reason":"%s","remediation":"%s"}\n' \
    "$(json_escape "$reason")" \
    "$(json_escape "$remediation")" >&2
}

ledger_path=""
ledger_version=""
ledger_abi=""

inspect_availability() {
  ledger_path="$(command -v ledger 2>/dev/null || true)"
  [[ -n "$ledger_path" ]]
}

inspect_readiness() {
  local capabilities capabilities_json line minor
  local abi_found=false
  ledger_version="$("$ledger_path" version 2>/dev/null || true)"
  [[ "$ledger_version" =~ ^1\.([0-9]+)\.([0-9]+)$ ]] || return 1
  minor="${BASH_REMATCH[1]}"
  if ((10#$minor < 1)); then
    return 1
  fi
  capabilities="$("$ledger_path" capabilities --format text 2>/dev/null || true)"
  while IFS= read -r line; do
    if [[ "$line" == "ABI: ledger-artifact-abi/v1" ]]; then
      abi_found=true
      break
    fi
  done <<<"$capabilities"
  [[ "$abi_found" == true ]] || return 1
  capabilities_json="$("$ledger_path" capabilities --format json 2>/dev/null || true)"
  for feature in \
    bounded_checkpoint_replay_v1 \
    full_history_doctor_v1 \
    segmented_event_log_v1 \
    segmented_migration_v1
  do
    grep -Fq "\"$feature\":true" <<<"$capabilities_json" || return 1
  done
  ledger_abi="ledger-artifact-abi/v1"
}

install_cli() {
  local os="${LEDGER_BOOTSTRAP_OS:-$(uname -s)}"
  if [[ "$os" != "Darwin" && "$os" != "Linux" ]]; then
    emit_error "unsupported-platform" "Install $formula manually, then retry."
    return 2
  fi
  if ! command -v brew >/dev/null 2>&1; then
    emit_error "homebrew-unavailable" "Install Homebrew, then rerun: ensure-ledger --install"
    return 2
  fi

  if brew list --versions "$formula" >/dev/null 2>&1; then
    emit_error "installed-but-unavailable" "Add the Homebrew ledger executable to PATH, then retry."
    return 2
  fi

  local install_status
  if brew install "$formula" >&2; then
    :
  else
    install_status=$?
    emit_error "homebrew-install-failed" "Fix the Homebrew failure, then rerun: ensure-ledger --install"
    return "$install_status"
  fi
  printf '%s' "installed"
}

upgrade_cli() {
  local os="${LEDGER_BOOTSTRAP_OS:-$(uname -s)}"
  if [[ "$os" != "Darwin" && "$os" != "Linux" ]] ||
    ! command -v brew >/dev/null 2>&1
  then
    emit_error "version-or-abi-mismatch" "Install or upgrade $formula to Ledger 1.1.0 or newer within major version 1 with ledger-artifact-abi/v1, then retry."
    return 2
  fi
  if ! brew list --versions "$formula" >/dev/null 2>&1; then
    emit_error "version-or-abi-mismatch-nonformula" "Replace the current ledger with $formula 1.1.0 or newer within major version 1, then retry."
    return 2
  fi
  if ! brew upgrade "$formula" >&2; then
    emit_error "homebrew-upgrade-failed" "Fix the Homebrew failure, then rerun: ensure-ledger --install"
    return 2
  fi
  printf '%s' "upgraded"
}

while (($#)); do
  case "$1" in
    --install)
      install_allowed=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      emit_error "unknown-option" "Use ensure-ledger --help."
      exit 2
      ;;
  esac
done

action="none"
if ! inspect_availability; then
  if [[ "$install_allowed" != true ]]; then
    emit_error "missing" "Authorize installation, then rerun: ensure-ledger --install"
    exit 3
  fi

  action="$(install_cli)" || exit $?
  hash -r
  if ! inspect_availability; then
    emit_error "post-install-unavailable" "Verify PATH and the installed $formula formula."
    exit 2
  fi
fi

if ! inspect_readiness; then
  if [[ "$install_allowed" != true ]]; then
    emit_error "version-or-abi-mismatch" "Authorize the canonical upgrade, then rerun: ensure-ledger --install"
    exit 3
  fi
  action="$(upgrade_cli)" || exit $?
  hash -r
  inspect_availability || {
    emit_error "post-upgrade-unavailable" "Verify PATH and the upgraded $formula formula."
    exit 2
  }
  if ! inspect_readiness; then
    emit_error "post-upgrade-version-or-abi-mismatch" "Verify $formula provides Ledger 1.1.0 or newer within major version 1 and ledger-artifact-abi/v1."
    exit 2
  fi
fi

printf '{"schema":"ledger-bootstrap-ready/v1","status":"ready","path":"%s","version":"%s","abi":"%s","action":"%s"}\n' \
  "$(json_escape "$ledger_path")" \
  "$(json_escape "$ledger_version")" \
  "$(json_escape "$ledger_abi")" \
  "$(json_escape "$action")"
