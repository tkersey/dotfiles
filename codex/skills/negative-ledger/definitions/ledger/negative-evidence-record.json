{
  "schema": "ledger-artifact-definition/v1",
  "id": "negative-ledger/negative-evidence-record",
  "owner": "negative-ledger",
  "imports": [
    {
      "id": "negative-ledger/negative-evidence-record-shape",
      "path": "negative-evidence-record-shape.json"
    }
  ],
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "at-least-one",
      "bounded-array",
      "bounded-string",
      "canonical-json",
      "definition-ref",
      "enum",
      "implies",
      "optional-field",
      "regex"
    ]
  },
  "parameters": {},
  "inputs": {
    "record": {
      "codec": "json",
      "required": true,
      "max_bytes": 4194304
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "record"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "definition-ref",
        "input": "record",
        "path": "",
        "definition": "negative-ledger/negative-evidence-record-shape"
      },
      {
        "op": "enum",
        "input": "record",
        "path": "/record_version",
        "values": [
          "NER-v2"
        ]
      },
      {
        "op": "enum",
        "input": "record",
        "path": "/kind",
        "values": [
          "authority_model",
          "kernel_distinction",
          "proof_pattern",
          "realization_route"
        ]
      },
      {
        "op": "bounded-string",
        "input": "record",
        "path": "/hypothesis",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "bounded-string",
        "input": "record",
        "path": "/attempted_change",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "bounded-string",
        "input": "record",
        "path": "/observed_outcome",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "enum",
        "input": "record",
        "path": "/failure_class",
        "values": [
          "global-regression",
          "local-regression",
          "no-effect",
          "stale",
          "too-complex",
          "unsound"
        ]
      },
      {
        "op": "enum",
        "input": "record",
        "path": "/confidence",
        "values": [
          "high",
          "low",
          "medium"
        ]
      },
      {
        "op": "bounded-string",
        "input": "record",
        "path": "/next_search_hint",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "bounded-array",
        "input": "record",
        "path": "/source_refs",
        "min": 1,
        "max": 128
      },
      {
        "op": "enum",
        "input": "record",
        "path": "/exclusion_scope",
        "values": [
          "authority_model",
          "cluster",
          "distinction_pattern",
          "exact",
          "proof_pattern",
          "route",
          "route_family"
        ]
      },
      {
        "op": "bounded-string",
        "input": "record",
        "path": "/exclusion_rule",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "bounded-array",
        "input": "record",
        "path": "/applicability_conditions",
        "min": 1,
        "max": 128
      },
      {
        "op": "bounded-array",
        "input": "record",
        "path": "/reopening_criteria",
        "min": 1,
        "max": 128
      },
      {
        "op": "optional-field",
        "input": "record",
        "path": "/status",
        "rules": [
          {
            "op": "enum",
            "path": "",
            "values": [
              "active"
            ]
          }
        ]
      },
      {
        "op": "implies",
        "input": "record",
        "if": "/exclusion_scope",
        "equals": "exact",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/route_id",
              "/route"
            ],
            "rules": [
              {
                "op": "bounded-string",
                "path": "",
                "trimmed_min": 1,
                "max": 4194304
              }
            ]
          }
        ]
      },
      {
        "op": "implies",
        "input": "record",
        "if": "/exclusion_scope",
        "equals": "route",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/route_id",
              "/route"
            ],
            "rules": [
              {
                "op": "bounded-string",
                "path": "",
                "trimmed_min": 1,
                "max": 4194304
              }
            ]
          }
        ]
      },
      {
        "op": "implies",
        "input": "record",
        "if": "/exclusion_scope",
        "equals": "route_family",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/route_family_id",
              "/route_or_model_id"
            ],
            "rules": [
              {
                "op": "bounded-string",
                "path": "",
                "trimmed_min": 1,
                "max": 4194304
              }
            ]
          }
        ]
      },
      {
        "op": "implies",
        "input": "record",
        "if": "/exclusion_scope",
        "equals": "cluster",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/cluster_id",
              "/cluster"
            ],
            "rules": [
              {
                "op": "bounded-string",
                "path": "",
                "trimmed_min": 1,
                "max": 4194304
              }
            ]
          }
        ]
      },
      {
        "op": "implies",
        "input": "record",
        "if": "/exclusion_scope",
        "equals": "authority_model",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/authority_model_id",
              "/route_or_model_id"
            ],
            "rules": [
              {
                "op": "bounded-string",
                "path": "",
                "trimmed_min": 1,
                "max": 4194304
              }
            ]
          }
        ]
      },
      {
        "op": "implies",
        "input": "record",
        "if": "/exclusion_scope",
        "equals": "distinction_pattern",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/distinction_pattern_id",
              "/route_or_model_id"
            ],
            "rules": [
              {
                "op": "bounded-string",
                "path": "",
                "trimmed_min": 1,
                "max": 4194304
              }
            ]
          }
        ]
      },
      {
        "op": "implies",
        "input": "record",
        "if": "/exclusion_scope",
        "equals": "proof_pattern",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/proof_pattern_id",
              "/route_or_model_id"
            ],
            "rules": [
              {
                "op": "bounded-string",
                "path": "",
                "trimmed_min": 1,
                "max": 4194304
              }
            ]
          }
        ]
      },
      {
        "op": "at-least-one",
        "input": "record",
        "paths": [
          "/artifact_state_id",
          "/artifact"
        ],
        "rules": [
          {
            "op": "regex",
            "path": "",
            "patterns": [
              "^[A-Fa-f0-9]{40}$",
              "^[A-Fa-f0-9]{64}$",
              "^commit:[A-Fa-f0-9]{40}$",
              "^commit:[A-Fa-f0-9]{64}$",
              "^tree:[A-Fa-f0-9]{40}$",
              "^tree:[A-Fa-f0-9]{64}$",
              "^sha256:[A-Fa-f0-9]{64}$",
              "^surface:[A-Fa-f0-9]{64}$"
            ],
            "max": 72
          }
        ]
      }
    ]
  },
  "constraints": [],
  "identity": {},
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 4194304,
    "max_store_bytes": 4194304,
    "max_records": 128,
    "max_output_bytes": 4194304,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
