{
  "schema": "ledger-artifact-definition/v1",
  "id": "universalist/plan-document",
  "owner": "universalist",
  "imports": [
    {
      "id": "tune/skill-decision-receipt",
      "path": "../../../tune/definitions/ledger/skill-decision-receipt.json"
    }
  ],
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "canonical-json",
      "compare-and-replace",
      "create-new",
      "definition-ref",
      "path-format",
      "text-render",
      "timestamp-ordinal"
    ]
  },
  "parameters": {
    "expected_revision": {
      "type": "digest",
      "required": false
    },
    "plan_file": {
      "type": "safe_identifier",
      "required": false
    },
    "plan_id": {
      "type": "safe_identifier",
      "required": false
    }
  },
  "inputs": {
    "receipt": {
      "codec": "json",
      "required": false,
      "max_bytes": 1048576
    },
    "template": {
      "codec": "text",
      "required": false,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "receipt"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "definition-ref",
        "input": "receipt",
        "path": "",
        "definition": "tune/skill-decision-receipt"
      }
    ]
  },
  "constraints": [],
  "identity": {},
  "storage": {
    "kind": "addressed-document",
    "slots": {
      "plan": {
        "path": "universalist/{plan_file}",
        "kind": "document",
        "codec": "text",
        "max_bytes": 2162688
      }
    }
  },
  "operations": {
    "append-receipt": {
      "effects": [
        {
          "op": "compare-and-replace",
          "slot": "plan",
          "input": "receipt",
          "expected_revision_param": "expected_revision",
          "document": {
            "mode": "edit",
            "line_prefix": "## Root decision receipt:",
            "line_replacement": [
              {
                "literal": "## Root decision receipt: emitted ("
              },
              {
                "input_text": "/skill_decision_receipt/decision_id"
              },
              {
                "literal": ")"
              }
            ],
            "insert_before": "## Status:",
            "reject_contains": "\"skill_decision_receipt\":",
            "append_separator": "\n\n",
            "trim_end": true,
            "final_newline": true
          }
        }
      ]
    },
    "create": {
      "effects": [
        {
          "op": "create-new",
          "slot": "plan",
          "input": "template",
          "document": {
            "mode": "template",
            "identity": {
              "op": "timestamp-ordinal",
              "name": "plan_id",
              "timestamp_name": "created_at",
              "path_name": "plan_file",
              "path_prefix": "plan-",
              "path_suffix": ".md",
              "ordinal_width": 4,
              "max_ordinal": 9999
            },
            "fragments": [
              {
                "literal": "---\nschema: universalist-plan/v1\nplan_id: "
              },
              {
                "generated": "plan_id"
              },
              {
                "literal": "\ncreated_at: "
              },
              {
                "generated": "created_at"
              },
              {
                "literal": "\n---\n\n"
              },
              {
                "input": true
              }
            ],
            "final_newline": true
          }
        }
      ]
    }
  },
  "projections": {},
  "bounds": {
    "max_input_bytes": 2097152,
    "max_store_bytes": 2162688,
    "max_records": 4,
    "max_output_bytes": 2162688,
    "max_diagnostics": 32,
    "max_reducer_states": 1
  }
}
