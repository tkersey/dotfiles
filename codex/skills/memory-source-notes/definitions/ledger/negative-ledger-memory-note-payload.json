        "op": "implies",
        "input": "note",
        "if": "/operation",
        "equals": "reopen",
        "then": "/payload/status",
        "then_equals": "reopened"
      },
      {
        "op": "implies",
        "input": "note",
        "if": "/operation",
        "equals": "reopen",
        "rules": [
