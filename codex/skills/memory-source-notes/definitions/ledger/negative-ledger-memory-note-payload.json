{
 "schema": "ledger-artifact-definition/v1",
 "id": "memory-source-notes/negative-ledger-memory-note-payload",
 "owner": "memory-source-notes",
 "imports": [{"id":"memory-source-notes/source-note-envelope","path":"source-note-envelope.json"}],
 "requires": {"abi":"ledger-artifact-abi/v1","operators":["all","bounded-array","bounded-number","bounded-object","bounded-string","canonical-json","definition-ref","enum","exact-object","field-equal","implies","one-of","optional-field","regex","safe-relative-path","scalar-type"]},
 "parameters": {},
 "inputs": {"note":{"codec":"json","required":true,"max_bytes":1048576}},
 "canonicalization": {"steps":[{"op":"canonical-json","input":"note"}]},
 "shape": {
  "documents": {
   "note": {
    "definition": "memory-source-notes/source-note-envelope",
    "fields": {
     "operation": {"enum":["assert","reopen"]},
     "authority": {"enum":["ledger-cli"]},
     "scope": {"fields":{"kind":{"enum":["repo"]}}},
     "payload": {
      "object": "exact",
      "fields": {
       "applicability_conditions": {"array":{"max":128},"items":{"string":{"trimmed_min":1,"max":4096}}},
       "applicable_paths": {"array":{"max":128},"items":{"string":{"trimmed_min":1,"max":4096}}},
       "artifact_state_id": {"string":{"trimmed_min":1,"max":512}},
       "artifact_state_label": {},
       "attempted_change": {"string":{"trimmed_min":1,"max":1048576}},
       "authority_model_id": {},
       "campaign_id": {},
       "capture_event_count": {"scalar":"integer","number":{"min":0,"max":10000000}},
       "cluster_id": {},
       "confidence": {"string":{"trimmed_min":1,"max":64}},
       "counterexample_family_ids": {"items":{"string":{"trimmed_min":1,"max":256}}},
       "distinction_pattern_id": {},
       "event_chain_fingerprint": {"string":{"min":64,"max":64},"regex":{"patterns":["^[a-f0-9]+$"],"max":64}},
       "exclusion_rule": {},
       "exclusion_scope": {"string":{"trimmed_min":1,"max":256}},
       "failure_class": {"string":{"trimmed_min":1,"max":256}},
       "falsifying_evidence": {"array":{"max":128},"items":{"string":{"trimmed_min":1,"max":4096}}},
       "hypothesis": {"string":{"trimmed_min":1,"max":1048576}},
       "kernel_law_ids": {"items":{"string":{"trimmed_min":1,"max":256}}},
       "kind": {"string":{"trimmed_min":1,"max":256}},
       "ledger_path": {"string":{"trimmed_min":1,"max":4096},"relative_path":{"allow_root":false}},
       "neg_id": {"string":{"trimmed_min":1,"max":256},"regex":{"patterns":["^NEG-[A-Za-z0-9][A-Za-z0-9._:-]*$"],"max":256}},
       "next_search_hint": {"string":{"trimmed_min":1,"max":1048576}},
       "observed_outcome": {"string":{"trimmed_min":1,"max":1048576}},
       "previous_projection_fingerprint": {"string":{"min":64,"max":64},"regex":{"patterns":["^[a-f0-9]+$"],"max":64},"if_present":"nullable"},
       "projection_fingerprint": {"string":{"min":64,"max":64},"regex":{"patterns":["^[a-f0-9]+$"],"max":64}},
       "proof_pattern_id": {},
       "record_version": {"enum":["NER-v2"]},
       "reopening_criteria": {"array":{"max":128},"items":{"object":"exact","fields":{"condition":{"string":{"trimmed_min":1,"max":4096}},"id":{"string":{"trimmed_min":1,"max":256}}}}},
       "repository_id": {"string":{"trimmed_min":1,"max":512}},
       "route_family_id": {},
       "route_id": {},
       "route_or_model_id": {},
       "schema": {"enum":["negative-ledger-projection/v3"]},
       "source_event_count": {"scalar":"integer","number":{"min":0,"max":10000000}},
       "source_refs": {"array":{"min":1,"max":128},"items":{"object":"closed","fields":{"kind":{"string":{"trimmed_min":1,"max":128}},"ref":{"string":{"trimmed_min":1,"max":4096}},"summary":{"optional":true,"string":{"trimmed_min":1,"max":4096}}}}},
       "status": {"enum":["accepted_risk","active","reopened","stale","superseded"]},
       "status_event_count": {"scalar":"integer","number":{"min":0,"max":10000000}}
      }
     }
    },
    "laws": [["field-equal",{"input":"note","left":"/payload/repository_id","right":"/scope/repo"}],["implies",{"input":"note","if":"/payload/status","equals":"active","rules":[["bounded-array",{"path":"/payload/applicability_conditions","min":1,"max":128}],["bounded-array",{"path":"/payload/reopening_criteria","min":1,"max":128}],["bounded-string",{"path":"/payload/exclusion_rule","trimmed_min":1,"max":1048576}]]}],["implies",{"input":"note","if":"/payload/status","equals":"reopened","then":"/operation","then_equals":"reopen"}],["implies",{"input":"note","if":"/operation","equals":"reopen","then":"/payload/status","then_equals":"reopened"}],["implies",{"input":"note","if":"/operation","equals":"reopen","rules":[["bounded-array",{"path":"/related_ids","min":1,"max":128}]]}]]
   }
  }
 },
 "constraints": {"laws":[]},
 "identity": {},
 "storage": {"kind":"pure"},
 "operations": {},
 "projections": {},
 "bounds": {"max_input_bytes":1048576,"max_store_bytes":1048576,"max_records":10000,"max_output_bytes":1048576,"max_diagnostics":64,"max_reducer_states":1}
}
