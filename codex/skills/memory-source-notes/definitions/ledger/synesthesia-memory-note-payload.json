{
  "schema": "ledger-artifact-definition/v1",
  "id": "memory-source-notes/synesthesia-memory-note-payload",
  "owner": "memory-source-notes",
  "imports": [
    {
      "id": "memory-source-notes/memory-note-id",
      "path": "memory-note-id.json"
    },
    {
      "id": "synesthesia/protocol",
      "path": "../../../synesthesia/definitions/ledger/synesthesia-protocol.json"
    }
  ],
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "bounded-array",
      "bounded-string",
      "canonical-json",
      "definition-ref",
      "enum",
      "exact-object",
      "field-equal",
      "optional-field",
      "tagged-union"
    ]
  },
  "parameters": {},
  "inputs": {
    "submission": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "submission"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "submission",
        "path": "",
        "keys": ["scope_anchor_source", "source"]
      },
      {
        "op": "definition-ref",
        "input": "submission",
        "path": "/source",
        "definition": "synesthesia/protocol"
      },
      {
        "op": "all",
        "input": "submission",
        "path": "/source/record/related_ids",
        "rules": [
          {
            "op": "definition-ref",
            "path": "",
            "definition": "memory-source-notes/memory-note-id"
          }
        ]
      },
      {
        "op": "optional-field",
        "input": "submission",
        "path": "/source/record/supersedes_id",
        "allow_null": true,
        "rules": [
          {
            "op": "definition-ref",
            "path": "",
            "definition": "memory-source-notes/memory-note-id"
          }
        ]
      },
      {
        "op": "bounded-string",
        "input": "submission",
        "path": "/source/record/payload/scope",
        "trimmed_min": 1,
        "max": 128
      },
      {
        "op": "bounded-string",
        "input": "submission",
        "path": "/source/record/payload/scope_anchor",
        "min": 1,
        "max": 4096
      },
      {
        "op": "field-equal",
        "input": "submission",
        "left": "/source/record/payload/endorsement_type",
        "right": "/source/record/authority"
      },
      {
        "op": "enum",
        "input": "submission",
        "path": "/scope_anchor_source",
        "values": ["kind", "path", "repo"]
      },
      {
        "op": "tagged-union",
        "input": "submission",
        "path": "",
        "tag": "/scope_anchor_source",
        "variants": [
          {
            "value": "path",
            "rules": [
              {
                "op": "bounded-array",
                "path": "/source/record/scope/paths",
                "min": 1,
                "max": 128
              },
              {
                "op": "field-equal",
                "left": "/source/record/payload/scope_anchor",
                "right": "/source/record/scope/paths/0"
              }
            ]
          },
          {
            "value": "repo",
            "rules": [
              {
                "op": "bounded-array",
                "path": "/source/record/scope/paths",
                "max": 0
              },
              {
                "op": "bounded-string",
                "path": "/source/record/scope/repo",
                "min": 1,
                "max": 512
              },
              {
                "op": "field-equal",
                "left": "/source/record/payload/scope_anchor",
                "right": "/source/record/scope/repo"
              }
            ]
          },
          {
            "value": "kind",
            "rules": [
              {
                "op": "bounded-array",
                "path": "/source/record/scope/paths",
                "max": 0
              },
              {
                "op": "enum",
                "path": "/source/record/scope/repo",
                "values": [null, ""]
              },
              {
                "op": "field-equal",
                "left": "/source/record/payload/scope_anchor",
                "right": "/source/record/scope/kind"
              }
            ]
          }
        ]
      },
      {
        "op": "tagged-union",
        "input": "submission",
        "path": "/source/record",
        "tag": "/scope/kind",
        "variants": [
          {
            "value": "global",
            "rules": [
              {"op": "enum", "path": "/payload/scope", "values": ["global_default"]}
            ]
          },
          {
            "value": "repo",
            "rules": [
              {"op": "enum", "path": "/payload/scope", "values": ["repo_scoped"]}
            ]
          },
          {
            "value": "path-family",
            "rules": [
              {"op": "enum", "path": "/payload/scope", "values": ["path_family_scoped"]}
            ]
          },
          {
            "value": "task-family",
            "rules": [
              {"op": "enum", "path": "/payload/scope", "values": ["task_family_scoped"]}
            ]
          },
          {
            "value": "workflow",
            "rules": [
              {"op": "enum", "path": "/payload/scope", "values": ["workflow_scoped"]}
            ]
          },
          {
            "value": "tool",
            "rules": [
              {"op": "enum", "path": "/payload/scope", "values": ["tool_scoped"]}
            ]
          }
        ]
      }
    ]
  },
  "constraints": [],
  "identity": {},
  "storage": {"kind": "pure"},
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 10000,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
