{
  "schema": "ledger-artifact-definition/v1",
  "id": "memory-source-notes/learnings-memory-note-payload",
  "owner": "memory-source-notes",
  "imports": [
    {
      "id": "memory-source-notes/source-note-envelope",
      "path": "source-note-envelope.json"
    }
  ],
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "all",
      "at-least-one",
      "bounded-array",
      "bounded-string",
      "canonical-json",
      "definition-ref",
      "enum",
      "exact-object",
      "field-equal",
      "implies",
      "one-of",
      "regex"
    ]
  },
  "parameters": {},
  "inputs": {
    "note": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "note"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "definition-ref",
        "input": "note",
        "path": "",
        "definition": "memory-source-notes/source-note-envelope"
      },
      {
        "op": "enum",
        "input": "note",
        "path": "/operation",
        "values": [
          "assert",
          "confirm",
          "retract",
          "supersede"
        ]
      },
      {
        "op": "enum",
        "input": "note",
        "path": "/authority",
        "values": [
          "ledger-cli"
        ]
      },
      {
        "op": "enum",
        "input": "note",
        "path": "/scope/kind",
        "values": [
          "repo"
        ]
      },
      {
        "op": "exact-object",
        "input": "note",
        "path": "/payload",
        "keys": [
          "canonical_fingerprint",
          "decision_delta",
          "evidence_snapshot",
          "future_behavior",
          "learning_id",
          "learning_status",
          "repo",
          "source_path",
          "tags",
          "verification"
        ]
      },
      {
        "op": "bounded-string",
        "input": "note",
        "path": "/payload/learning_id",
        "trimmed_min": 1,
        "max": 256
      },
      {
        "op": "regex",
        "input": "note",
        "path": "/payload/learning_id",
        "patterns": [
          "^lrn-[A-Za-z0-9][A-Za-z0-9._:-]*$"
        ],
        "max": 256
      },
      {
        "op": "enum",
        "input": "note",
        "path": "/payload/learning_status",
        "values": [
          "avoid_for_now",
          "codify_now",
          "do_less",
          "do_more",
          "investigate_more",
          "review_later"
        ]
      },
      {
        "op": "bounded-string",
        "input": "note",
        "path": "/payload/repo",
        "trimmed_min": 1,
        "max": 512
      },
      {
        "op": "field-equal",
        "input": "note",
        "left": "/payload/repo",
        "right": "/scope/repo"
      },
      {
        "op": "bounded-string",
        "input": "note",
        "path": "/payload/source_path",
        "trimmed_min": 1,
        "max": 4096
      },
      {
        "op": "bounded-string",
        "input": "note",
        "path": "/payload/decision_delta",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "bounded-array",
        "input": "note",
        "path": "/payload/evidence_snapshot",
        "min": 1,
        "max": 128
      },
      {
        "op": "all",
        "input": "note",
        "path": "/payload/evidence_snapshot",
        "rules": [
          {
            "op": "bounded-string",
            "path": "",
            "trimmed_min": 1,
            "max": 4096
          }
        ]
      },
      {
        "op": "bounded-string",
        "input": "note",
        "path": "/payload/future_behavior",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "bounded-string",
        "input": "note",
        "path": "/payload/verification",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "bounded-array",
        "input": "note",
        "path": "/payload/tags",
        "max": 128
      },
      {
        "op": "all",
        "input": "note",
        "path": "/payload/tags",
        "rules": [
          {
            "op": "bounded-string",
            "path": "",
            "trimmed_min": 1,
            "max": 256
          }
        ]
      },
      {
        "op": "bounded-string",
        "input": "note",
        "path": "/payload/canonical_fingerprint",
        "min": 16,
        "max": 16
      },
      {
        "op": "regex",
        "input": "note",
        "path": "/payload/canonical_fingerprint",
        "patterns": [
          "^[a-f0-9]+$"
        ],
        "max": 16
      },
      {
        "op": "implies",
        "input": "note",
        "if": "/operation",
        "equals": "confirm",
        "rules": [
          {
            "op": "bounded-array",
            "path": "/related_ids",
            "min": 1,
            "max": 128
          }
        ]
      },
      {
        "op": "implies",
        "input": "note",
        "if": "/operation",
        "equals": "supersede",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/related_ids",
              "/supersedes_id"
            ],
            "rules": [
              {
                "op": "one-of",
                "path": "",
                "rules": [
                  {
                    "op": "bounded-array",
                    "path": "",
                    "min": 1,
                    "max": 128
                  },
                  {
                    "op": "bounded-string",
                    "path": "",
                    "trimmed_min": 1,
                    "max": 256
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "op": "implies",
        "input": "note",
        "if": "/operation",
        "equals": "retract",
        "rules": [
          {
            "op": "at-least-one",
            "paths": [
              "/related_ids",
              "/supersedes_id"
            ],
            "rules": [
              {
                "op": "one-of",
                "path": "",
                "rules": [
                  {
                    "op": "bounded-array",
                    "path": "",
                    "min": 1,
                    "max": 128
                  },
                  {
                    "op": "bounded-string",
                    "path": "",
                    "trimmed_min": 1,
                    "max": 256
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "constraints": [],
  "identity": {},
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 10000,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
