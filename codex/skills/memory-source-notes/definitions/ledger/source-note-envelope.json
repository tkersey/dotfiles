{
  "schema": "ledger-artifact-definition/v1",
  "id": "memory-source-notes/source-note-envelope",
  "owner": "memory-source-notes",
  "imports": [
    {
      "id": "memory-source-notes/source-note-record",
      "path": "source-note-record.json"
    }
  ],
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "canonical-json",
      "definition-ref",
      "exact-object"
    ]
  },
  "parameters": {},
  "inputs": {
    "note": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "note"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "note",
        "path": "",
        "required_keys": [
          "authority",
          "operation",
          "payload",
          "scope",
          "source_refs",
          "summary"
        ],
        "optional_keys": [
          "related_ids",
          "slug",
          "supersedes_id"
        ],
        "allow_additional": false
      },
      {
        "op": "definition-ref",
        "input": "note",
        "path": "",
        "definition": "memory-source-notes/source-note-record"
      }
    ]
  },
  "constraints": [],
  "identity": {},
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 10000,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
