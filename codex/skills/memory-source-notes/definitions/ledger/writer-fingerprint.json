{
  "schema": "ledger-artifact-definition/v1",
  "id": "memory-source-notes/writer-fingerprint",
  "owner": "memory-source-notes",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "bounded-string",
      "canonical-json",
      "exact-object",
      "sha256"
    ]
  },
  "parameters": {},
  "inputs": {
    "basis": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "basis"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "basis",
        "path": "",
        "keys": [
          "expected",
          "extension",
          "kind",
          "raw_projection"
        ]
      },
      {
        "op": "bounded-string",
        "input": "basis",
        "path": "/extension",
        "trimmed_min": 1,
        "max": 64
      },
      {
        "op": "bounded-string",
        "input": "basis",
        "path": "/kind",
        "trimmed_min": 1,
        "max": 128
      },
      {
        "op": "bounded-string",
        "input": "basis",
        "path": "/raw_projection",
        "min": 3,
        "max": 1048576
      },
      {
        "op": "sha256",
        "input": "basis",
        "path": "",
        "mode": "framed-fields",
        "field": "/expected",
        "prefix": "",
        "fragments": [
          {
            "parent": "/extension"
          },
          {
            "literal": "\n"
          },
          {
            "parent": "/kind"
          },
          {
            "literal": "\n"
          },
          {
            "parent": "/raw_projection"
          }
        ],
        "max_bytes": 1048576
      }
    ]
  },
  "constraints": [],
  "identity": {},
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 10000,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
