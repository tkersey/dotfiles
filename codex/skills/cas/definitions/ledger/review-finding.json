{
  "schema": "ledger-artifact-definition/v1",
  "id": "cas/review-finding",
  "owner": "cas",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "bounded-number",
      "bounded-string",
      "canonical-json",
      "content-address",
      "exact-object",
      "scalar-type"
    ]
  },
  "parameters": {},
  "inputs": {
    "finding": {
      "codec": "json",
      "required": true,
      "max_bytes": 1048576
    }
  },
  "canonicalization": {
    "steps": [
      {
        "op": "canonical-json",
        "input": "finding"
      }
    ]
  },
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "finding",
        "path": "",
        "keys": [
          "body",
          "file",
          "line",
          "priority",
          "title"
        ]
      },
      {
        "op": "bounded-string",
        "input": "finding",
        "path": "/title",
        "trimmed_min": 1,
        "max": 65536
      },
      {
        "op": "bounded-string",
        "input": "finding",
        "path": "/body",
        "trimmed_min": 1,
        "max": 1048576
      },
      {
        "op": "bounded-string",
        "input": "finding",
        "path": "/file",
        "trimmed_min": 1,
        "max": 4096
      },
      {
        "op": "scalar-type",
        "input": "finding",
        "path": "/line",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "input": "finding",
        "path": "/line",
        "min": 1,
        "max": 4294967295
      },
      {
        "op": "scalar-type",
        "input": "finding",
        "path": "/priority",
        "type": "integer"
      },
      {
        "op": "bounded-number",
        "input": "finding",
        "path": "/priority",
        "min": 0,
        "max": 3
      }
    ]
  },
  "constraints": [],
  "identity": {
    "op": "content-address",
    "input": "finding"
  },
  "storage": {
    "kind": "pure"
  },
  "operations": {},
  "projections": {},
  "bounds": {
    "max_input_bytes": 1048576,
    "max_store_bytes": 1048576,
    "max_records": 4096,
    "max_output_bytes": 1048576,
    "max_diagnostics": 64,
    "max_reducer_states": 1
  }
}
