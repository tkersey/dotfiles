{
  "schema": "seq-observation-definition/v1",
  "id": "seq/tool-search",
  "requires": {
    "abi": "seq-observation-abi/v1",
    "operators": [
      "filter",
      "limit",
      "project",
      "scan",
      "sort"
    ]
  },
  "parameters": {
    "needle": {
      "type": "string",
      "required": true
    }
  },
  "selectors": [
    "path"
  ],
  "relations": [
    {
      "name": "tool_lifecycle",
      "fields": [
        "call_id",
        "session_id",
        "turn_index",
        "started_at",
        "completed_at",
        "kind",
        "tool_name",
        "namespace",
        "arguments_json",
        "input_text",
        "output_text",
        "command_text",
        "cwd",
        "exit_code",
        "duration_ms",
        "lifecycle_status",
        "path"
      ]
    }
  ],
  "inputs": [],
  "pipeline": [
    {
      "op": "scan",
      "relation": "tool_lifecycle",
      "as": "source"
    },
    {
      "op": "filter",
      "input": "source",
      "as": "matched",
      "where_mode": "any",
      "where": [
        {
          "field": "tool_name",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "namespace",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "arguments_json",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "input_text",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "output_text",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        },
        {
          "field": "command_text",
          "op": "contains",
          "param": "needle",
          "case_insensitive": true
        }
      ]
    },
    {
      "op": "sort",
      "input": "matched",
      "as": "newest",
      "by": [
        {
          "field": "started_at",
          "direction": "desc",
          "nulls": "last"
        },
        {
          "field": "path",
          "direction": "desc"
        },
        {
          "field": "turn_index",
          "direction": "desc",
          "nulls": "last"
        }
      ]
    },
    {
      "op": "project",
      "input": "newest",
      "as": "selected",
      "fields": [
        "call_id",
        "session_id",
        "turn_index",
        "started_at",
        "completed_at",
        "kind",
        "tool_name",
        "namespace",
        "arguments_json",
        "input_text",
        "output_text",
        "command_text",
        "cwd",
        "exit_code",
        "duration_ms",
        "lifecycle_status",
        "path"
      ]
    },
    {
      "op": "limit",
      "input": "selected",
      "as": "rows",
      "limit": 100
    }
  ],
  "projections": {
    "rows": {
      "relation": "rows",
      "schema": "seq-tool-search-result/v1",
      "fields": [
        "call_id",
        "session_id",
        "turn_index",
        "started_at",
        "completed_at",
        "kind",
        "tool_name",
        "namespace",
        "arguments_json",
        "input_text",
        "output_text",
        "command_text",
        "cwd",
        "exit_code",
        "duration_ms",
        "lifecycle_status",
        "path"
      ],
      "renderers": [
        "json"
      ]
    }
  },
  "bounds": {
    "max_rows": 100,
    "max_output_bytes": 2097152,
    "max_fold_states": 1
  }
}
