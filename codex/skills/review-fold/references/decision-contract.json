{
  "skill_decision_contract": {
    "contract_version": "SKDC-v1",
    "skill": {
      "name": "review-fold",
      "kind": "mixed",
      "source_fingerprint": "review-fold-live-evidence-v1"
    },
    "triggers": [
      {
        "trigger_id": "RF-SOURCE",
        "description": "Current owner-issued falsification evidence needs classification.",
        "cue_literals": [
          "review finding",
          "failing test",
          "incident",
          "bug report",
          "migration failure",
          "compatibility failure"
        ],
        "cue_regexes": [],
        "exclusions": []
      },
      {
        "trigger_id": "RF-CLASS",
        "description": "Multiple observations may witness one stable law-and-boundary class or causal mechanism.",
        "cue_literals": [
          "duplicate finding",
          "same law",
          "same boundary",
          "recurrence"
        ],
        "cue_regexes": [],
        "exclusions": []
      },
      {
        "trigger_id": "RF-SOURCE-REVISION",
        "description": "Changed accepted authority requires current evidence to be reclassified against the new Goal.",
        "cue_literals": [
          "source revision",
          "successor Goal",
          "changed scope",
          "follow-up"
        ],
        "cue_regexes": [],
        "exclusions": []
      }
    ],
    "routes": [
      {
        "route_id": "RF-FOLD",
        "description": "Return the current analytical Review Fold.",
        "aliases": [
          "accepted",
          "rejected",
          "follow-up"
        ],
        "terminal": true
      },
      {
        "route_id": "RF-BLOCK",
        "description": "Block a classification when evidence, applicability, ownership, or identity is unknown.",
        "aliases": [
          "blocked"
        ],
        "terminal": true
      }
    ],
    "clauses": [
      {
        "clause_id": "RF-CLASSIFY-001",
        "trigger_refs": [
          "RF-SOURCE"
        ],
        "expected_routes": [
          "RF-FOLD",
          "RF-BLOCK"
        ],
        "prohibited_routes": [],
        "required_artifacts": [
          "current Goal",
          "exact Git head",
          "owner-issued source evidence",
          "one disposition per current class"
        ],
        "success_signals": [
          "claims facts and suggested repairs are separate",
          "a clean source is representable",
          "output is returned directly to Actuating"
        ],
        "failure_signals": [
          "review prose selects work",
          "unknown evidence is treated as current",
          "a Counterexample Set or Ledger record is created"
        ],
        "rationale": "Classification remains current analysis rather than a second durable evidence world."
      },
      {
        "clause_id": "RF-QUOTIENT-001",
        "trigger_refs": [
          "RF-CLASS"
        ],
        "expected_routes": [
          "RF-FOLD",
          "RF-BLOCK"
        ],
        "prohibited_routes": [],
        "required_artifacts": [
          "law",
          "boundary",
          "discrepancy",
          "owner",
          "witness",
          "applicability",
          "quotient basis",
          "exact evidence references"
        ],
        "success_signals": [
          "duplicates collapse",
          "recurrence is established only from exact available prior evidence",
          "shared causal mechanisms are evidenced"
        ],
        "failure_signals": [
          "attempt or patch identity defines a class",
          "memory or summary manufactures recurrence",
          "a repair is selected"
        ],
        "rationale": "Actuating receives stable current pressure without maintaining a parallel class register."
      },
      {
        "clause_id": "RF-REVISION-001",
        "trigger_refs": [
          "RF-SOURCE-REVISION"
        ],
        "expected_routes": [
          "RF-FOLD",
          "RF-BLOCK"
        ],
        "prohibited_routes": [],
        "required_artifacts": [
          "current revised Goal",
          "currently available applicable owner evidence"
        ],
        "success_signals": [
          "all available relevant evidence is reclassified under current authority",
          "missing historical sources remain explicit"
        ],
        "failure_signals": [
          "predecessor Set carry-forward is required",
          "source revision erases known current evidence",
          "missing owner history is invented"
        ],
        "rationale": "Current owner facts are reinterpreted directly instead of copied through artifact lineage."
      }
    ],
    "instrumentation": {
      "decision_receipt": "not-needed",
      "rationale": "The Review Fold is returned in the active workflow; durable facts remain with their source owners."
    }
  }
}
