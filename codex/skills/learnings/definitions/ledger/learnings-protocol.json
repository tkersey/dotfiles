                "max_bytes": 1048576
              },
              {
                "name": "learning_id",
                "op": "concat",
                "fragments": [
                  {
                    "literal": "lrn-"
                  },
                  {
                    "derived": "captured_at",
                    "transform": "compact-utc"
                  },
                  {
                    "literal": "-"
                  },
                  {
                    "derived": "fingerprint",
                    "prefix_bytes": 8
                  }
                ],
                "max_bytes": 64
              }
            ],
            "idempotency": {
              "derived": "fingerprint",
              "bypass_param": "allow_duplicate"
            },
            "body_fields": [
              {
                "field": "id",
                "derived": "learning_id"
              },
              {
                "field": "captured_at",
                "derived": "captured_at"
              },
              {
                "field": "fingerprint",
                "derived": "fingerprint"
              }
            ]
          }
        }
      ]
    }
