        }
      ]
    },
    "recent": {
      "slot": "events",
      "pipeline": [
        {
          "op": "sort",
          "keys": [
            {
              "meta": "record-order",
              "order": "descending"
            }
          ]
        },
        {
          "op": "export",
          "fields": [
            {
              "name": "id",
              "path": "/record/id"
            },
            {
              "name": "captured_at",
              "path": "/record/captured_at"
            },
            {
              "name": "kind",
              "path": "/record/kind"
            },
            {
              "name": "operation",
              "path": "/record/operation"
            },
            {
              "name": "summary",
              "path": "/record/summary"
            }
          ]
        },
        {
          "op": "limit",
          "param": "limit"
        }
      ]
    }
